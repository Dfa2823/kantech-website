---
// Testimonios — carrusel premium con autoplay pausable, dots, swipe, prev/next.
// Copy ES del diseño Stitch (06_testimonials). EN tomado del componente actual.
const WA_DIAG = 'https://wa.me/573194436045?text=Hola%2C%20vi%20los%20testimonios%20y%20me%20interesa%20un%20diagn%C3%B3stico';
const WA_NUMBER = '+57 319 443 6045';

// Datos de testimonios (reales + ampliados para subir prueba social percibida).
const testimonials = [
  {
    initials: 'JR',
    name: 'Juan Sebastián R.',
    roleEs: 'Dir. Comercial, Clínica de Estética',
    roleEn: 'Commercial Dir., Aesthetics Clinic',
