---
<section id="testimonios" class="relative py-24 px-6 overflow-hidden">
  <!-- Aurora sutil de fondo -->
  <div class="aurora-bg" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto">

    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-16 animate-fade-up" data-animate>
      <div class="section-label mb-6">
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">forum</span>
        <span data-lang="es">Clientes</span>
        <span data-lang="en">Clients</span>
      </div>
      <h2 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-text leading-tight mb-6">
        <span data-lang="es">Lo que dicen <span class="gradient-text">quienes ya lo vivieron</span>.</span>
        <span data-lang="en">What those who've <span class="gradient-text">already lived it say</span>.</span>
      </h2>
      <p class="font-body text-lg text-muted max-w-2xl mx-auto leading-relaxed">
        <span data-lang="es">No te lo contamos nosotros. Te lo cuentan quienes ya dejaron de perder tiempo y dinero en procesos manuales.</span>
        <span data-lang="en">Don't take our word for it. Hear from those who stopped losing time and money on manual processes.</span>
      </p>

      <!-- Prueba agregada -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm">
        <div class="flex items-center gap-2">
          <div class="flex text-accent" role="img" aria-label="Valoración 5 de 5 estrellas" data-stars-stagger>
            <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
            <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
          </div>
          <span class="font-medium text-text"><span data-counter-decimal="5.0">5.0</span></span>
        </div>
        <div class="w-px h-4 bg-border" aria-hidden="true"></div>
        <div class="text-text font-medium">
          <span data-lang="es">100+ clientes satisfechos</span>
          <span data-lang="en">100+ satisfied clients</span>
        </div>
        <div class="w-px h-4 bg-border hidden sm:block" aria-hidden="true"></div>
        <div class="text-muted w-full sm:w-auto">
          <span data-lang="es">Sectores: Salud, Manufactura, Logística</span>
          <span data-lang="en">Sectors: Health, Manufacturing, Logistics</span>
        </div>
      </div>
    </header>

    <!-- Carrusel de testimonios -->
    <div
      class="tst-carousel relative"
      data-tst-carousel
      role="region"
      aria-roledescription="carrusel"
      aria-label="Testimonios de clientes"
    >
      <!-- Viewport -->
      <div class="tst-viewport overflow-hidden rounded-2xl" data-tst-viewport>
        <ul class="tst-track flex" data-tst-track aria-live="polite">
          {testimonials.map((t, i) => (
            <li
              class="tst-slide shrink-0 w-full px-1"
              data-tst-slide
              role="group"
              aria-roledescription="testimonio"
              aria-label={`Testimonio ${i + 1} de ${testimonials.length}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <article class="card-glow bg-surface-1 rounded-2xl p-8 md:p-10 border border-border/20 glass-panel hover-lift relative overflow-hidden group h-full">
                <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500" aria-hidden="true"></div>

                <div class="relative z-10 flex flex-col h-full">
                  <div class="flex justify-between items-start mb-6">
                    <span class="material-symbols-outlined text-4xl text-primary opacity-50 tst-quote transition-all duration-500 group-hover:opacity-80 group-hover:scale-110" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">format_quote</span>
                    <div class="flex text-accent text-sm" role="img" aria-label="Valoración 5 de 5 estrellas">
                      <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
                      <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
                      <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
                      <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
                      <span class="material-symbols-outlined" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">star</span>
                    </div>
                  </div>

                  <h3 class="font-display font-bold text-2xl md:text-3xl text-text mb-4 leading-snug">
                    <span data-lang="es" set:html={t.titleEs} />
                    <span data-lang="en" set:html={t.titleEn} />
                  </h3>

                  <blockquote class="font-body text-base md:text-lg text-muted mb-8 leading-relaxed flex-grow">
                    <span data-lang="es">{t.quoteEs}</span>
                    <span data-lang="en">{t.quoteEn}</span>
                  </blockquote>

                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mt-auto pt-6 border-t border-border/30">
                    <cite class="flex items-center gap-4 not-italic">
                      <span class="w-12 h-12 rounded-full bg-brand-gradient flex items-center justify-center text-white font-display font-bold shadow-lg shadow-primary/20 shrink-0" aria-hidden="true">
                        {t.initials}
                      </span>
                      <span class="block">
                        <span class="flex items-center gap-1.5">
                          <span class="font-medium text-text">{t.name}</span>
                          {t.verified && (
                            <span class="tst-verified relative inline-flex items-center" tabindex="0" role="img"
                              aria-label="Cliente verificado">
                              <span class="material-symbols-outlined text-[16px] text-accent" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">verified</span>
                              <span class="tst-tooltip" role="tooltip">
                                <span data-lang="es">Cliente verificado</span>
                                <span data-lang="en">Verified client</span>
                              </span>
                            </span>
                          )}
                        </span>
                        <span class="block text-sm text-muted">
                          <span data-lang="es">{t.roleEs}</span>
                          <span data-lang="en">{t.roleEn}</span>
                        </span>
                      </span>
                    </cite>

                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-3 border border-border/50 text-xs font-medium text-text">
                        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">location_on</span>
                        {t.city}
                      </span>
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-success/10 border border-success/20 text-success text-xs font-bold uppercase tracking-wide">
                        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">{t.metricIcon}</span>
                        {t.metricCount ? (
                          <span>
                            {t.metricPrefix}<span data-counter-metric={String(t.metricCount)}>0</span><span data-lang="es">{t.metricSuffixEs}</span><span data-lang="en">{t.metricSuffixEn}</span>
                          </span>
                        ) : (
                          <span>
                            <span data-lang="es">{t.metricStaticEs}</span>
                            <span data-lang="en">{t.metricStaticEn}</span>
                          </span>
                        )}
                      </span>
                      {t.caseLink && (
                        <a class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-text transition-colors group/case w-fit" href={t.caseLink}>
                          <span data-lang="es">Ver caso</span>
                          <span data-lang="en">View case</span>
                          <span class="material-symbols-outlined text-[16px] group-hover/case:translate-x-1 transition-transform" aria-hidden="true">arrow_forward</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <!-- Controles -->
      <div class="mt-8 flex items-center justify-center gap-4">
        <button
          type="button"
          class="tst-arrow inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface-2 border border-border/50 text-text transition-all hover:border-primary/60 hover:text-primary active:scale-95 disabled:opacity-40"
          data-tst-prev
          aria-label="Testimonio anterior"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>

        <!-- Dots -->
        <div class="flex items-center gap-2" role="tablist" aria-label="Seleccionar testimonio" data-tst-dots>
          {testimonials.map((t, i) => (
            <button
              type="button"
              class="tst-dot rounded-full transition-all"
              data-tst-dot={String(i)}
              role="tab"
              aria-label={`Ir al testimonio ${i + 1}: ${t.name}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>

        <button
          type="button"
          class="tst-arrow inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface-2 border border-border/50 text-text transition-all hover:border-primary/60 hover:text-primary active:scale-95 disabled:opacity-40"
          data-tst-next
          aria-label="Testimonio siguiente"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>

        <!-- Pausa/reproducción del autoplay -->
        <button
          type="button"
          class="tst-arrow inline-flex items-center justify-center w-11 h-11 rounded-full bg-surface-2 border border-border/50 text-text transition-all hover:border-primary/60 hover:text-primary active:scale-95 ml-1"
          data-tst-playpause
          aria-pressed="false"
          aria-label="Pausar reproducción automática"
        >
          <span class="material-symbols-outlined tst-icon-pause" aria-hidden="true">pause</span>
          <span class="material-symbols-outlined tst-icon-play hidden" aria-hidden="true">play_arrow</span>
        </button>
      </div>
    </div>

    <!-- CTA de sección -->
    <div class="mt-20 text-center animate-fade-up delay-400" data-animate>
      <h4 class="font-display font-medium text-xl text-text mb-6">
        <span data-lang="es">¿Quieres resultados como estos en tu empresa?</span>
        <span data-lang="en">Want results like these for your business?</span>
      </h4>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={WA_DIAG} target="_blank" rel="noopener" class="btn-primary text-base px-8 py-4 group">
          <span data-lang="es">Agenda tu diagnóstico gratis</span>
          <span data-lang="en">Book your free diagnosis</span>
          <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform" aria-hidden="true">arrow_right_alt</span>
        </a>
        <button
          type="button"
          class="btn-outline text-base px-8 py-4 group"
          data-tst-copy
          data-wa-number={WA_NUMBER}
          aria-label={`Copiar nuestro WhatsApp ${WA_NUMBER} al portapapeles`}
        >
          <span class="material-symbols-outlined text-[20px] text-muted group-hover:text-text transition-colors tst-copy-icon" aria-hidden="true">content_copy</span>
          <span class="tst-copy-label" data-lang="es">Copiar nuestro WhatsApp</span>
          <span class="tst-copy-label" data-lang="en">Copy our WhatsApp</span>
        </button>
      </div>
      <!-- Anuncio accesible de la acción de copiar -->
      <p class="mt-3 text-sm text-success font-medium h-5" data-tst-copy-status role="status" aria-live="polite"></p>
      <p class="mt-2 text-xs text-muted flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[14px] text-success" aria-hidden="true">shield_lock</span>
        <span data-lang="es">Diagnóstico gratis · Sin permanencia · Respuesta en &lt;24h</span>
        <span data-lang="en">Free diagnosis · No commitment · Reply in &lt;24h</span>
      </p>
    </div>
  </div>
</section>

<style is:global>
  /* Aurora sutil local de la sección Testimonios (radial estático, sin JS) */
  #testimonios .aurora-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(circle at 50% 0%, rgba(106,195,198, 0.10) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(106,195,198, 0.05) 0%, transparent 40%);
  }

  /* Hover lift suave para las tarjetas de testimonio */
  #testimonios .hover-lift {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #testimonios .hover-lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -8px rgba(106,195,198, 0.15);
  }

  /* Carrusel: el track se desplaza con transform; cada slide ocupa el ancho del viewport */
  #testimonios .tst-track {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  #testimonios .tst-viewport { cursor: grab; }
  #testimonios .tst-viewport.is-dragging { cursor: grabbing; }
  #testimonios .tst-viewport.is-dragging .tst-track { transition: none; }
  /* Igualar altura de tarjetas para que el carrusel no salte al cambiar */
  #testimonios .tst-track { align-items: stretch; }

  /* Dots */
  #testimonios .tst-dot {
    width: 8px;
    height: 8px;
    background: var(--tw-border, #33507D);
    background-color: rgba(169,182,204,0.35);
  }
  #testimonios .tst-dot[aria-selected="true"] {
    width: 24px;
    background-color: #6AC3C6;
  }

  /* Badge verificado: tooltip */
  #testimonios .tst-verified { cursor: help; }
  #testimonios .tst-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    white-space: nowrap;
    background: #07101F;
    color: #E6EDF7;
    border: 1px solid rgba(106,195,198,0.3);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 20;
  }
  #testimonios .tst-verified:hover .tst-tooltip,
  #testimonios .tst-verified:focus-visible .tst-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    #testimonios .hover-lift { transition: none; }
    #testimonios .hover-lift:hover { transform: none; }
    #testimonios .tst-track { transition: none !important; }
    #testimonios .tst-quote { transition: none !important; }
    #testimonios .tst-dot { transition: none; }
    #testimonios .tst-tooltip { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // ---- Count-up genérico para métricas y "5.0" (respeta reduced-motion) ----
    function animateCount(el, target, decimals, duration) {
      if (!el) return;
      if (reduceMotion.matches) {
        el.textContent = decimals ? target.toFixed(decimals) : String(Math.round(target));
        return;
      }
      const start = performance.now();
      function tick(now) {
        const p = Math.min((now - start) / duration, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        const val = target * ease;
        el.textContent = decimals ? val.toFixed(decimals) : String(Math.round(val));
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function initCounters() {
      const metrics = document.querySelectorAll('#testimonios [data-counter-metric]');
      const decimals = document.querySelectorAll('#testimonios [data-counter-decimal]');
      const stars = document.querySelectorAll('#testimonios [data-stars-stagger]');

      if (!('IntersectionObserver' in window)) {
        metrics.forEach(function (el) { el.textContent = el.dataset.counterMetric; });
        decimals.forEach(function (el) { el.textContent = parseFloat(el.dataset.counterDecimal).toFixed(1); });
        return;
      }

      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          if (el.hasAttribute('data-counter-metric')) {
            animateCount(el, parseInt(el.dataset.counterMetric, 10), 0, 1400);
          } else if (el.hasAttribute('data-counter-decimal')) {
            animateCount(el, parseFloat(el.dataset.counterDecimal), 1, 1200);
          } else if (el.hasAttribute('data-stars-stagger')) {
            staggerStars(el);
          }
          io.unobserve(el);
        });
      }, { threshold: 0.4 });

      metrics.forEach(function (el) { io.observe(el); });
      decimals.forEach(function (el) { io.observe(el); });
      stars.forEach(function (el) { io.observe(el); });
    }

    // ---- Stagger de aparición de las 5 estrellas del header ----
    function staggerStars(wrapper) {
      const icons = wrapper.querySelectorAll('.material-symbols-outlined');
      if (reduceMotion.matches) return; // sin animación, ya visibles
      icons.forEach(function (icon, i) {
        icon.style.opacity = '0';
        icon.style.transform = 'scale(0.4)';
        icon.style.transition = 'opacity 0.25s ease, transform 0.25s cubic-bezier(0.34,1.56,0.64,1)';
        setTimeout(function () {
          icon.style.opacity = '1';
          icon.style.transform = 'scale(1)';
        }, i * 80);
      });
    }

    // ---- Carrusel ----
    function initCarousel() {
      const root = document.querySelector('[data-tst-carousel]');
      if (!root) return;
      const viewport = root.querySelector('[data-tst-viewport]');
      const track = root.querySelector('[data-tst-track]');
      const slides = Array.prototype.slice.call(root.querySelectorAll('[data-tst-slide]'));
      const prevBtn = root.querySelector('[data-tst-prev]');
      const nextBtn = root.querySelector('[data-tst-next]');
      const dots = Array.prototype.slice.call(root.querySelectorAll('[data-tst-dot]'));
      const playBtn = root.querySelector('[data-tst-playpause]');
      if (!track || slides.length === 0) return;

      const total = slides.length;
      let current = 0;
      let autoplayId = null;
      let isPlaying = true;
      const AUTOPLAY_MS = 6000;

      function render() {
        track.style.transform = 'translateX(' + (-current * 100) + '%)';
        slides.forEach(function (s, i) {
          s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });
        dots.forEach(function (d, i) {
          d.setAttribute('aria-selected', i === current ? 'true' : 'false');
        });
      }

      function goTo(index) {
        current = (index + total) % total;
        render();
      }
      function next() { goTo(current + 1); }
      function prev() { goTo(current - 1); }

      // ---- Autoplay (gateado por reduced-motion) ----
      function startAutoplay() {
        if (reduceMotion.matches) return;
        stopAutoplay();
        autoplayId = window.setInterval(next, AUTOPLAY_MS);
        isPlaying = true;
        updatePlayBtn();
      }
      function stopAutoplay() {
        if (autoplayId !== null) {
          window.clearInterval(autoplayId);
          autoplayId = null;
        }
      }
      function pauseAutoplay() {
        stopAutoplay();
        isPlaying = false;
        updatePlayBtn();
      }
      function updatePlayBtn() {
        if (!playBtn) return;
        const pauseIcon = playBtn.querySelector('.tst-icon-pause');
        const playIcon = playBtn.querySelector('.tst-icon-play');
        playBtn.setAttribute('aria-pressed', isPlaying ? 'false' : 'true');
        playBtn.setAttribute('aria-label', isPlaying ? 'Pausar reproducción automática' : 'Reanudar reproducción automática');
        if (pauseIcon) pauseIcon.classList.toggle('hidden', !isPlaying);
        if (playIcon) playIcon.classList.toggle('hidden', isPlaying);
      }

      // Si reduced-motion: ocultar el control de play/pausa (no hay autoplay que controlar)
      if (reduceMotion.matches && playBtn) {
        playBtn.classList.add('hidden');
      }

      // ---- Eventos botones ----
      if (nextBtn) nextBtn.addEventListener('click', function () { next(); startAutoplay(); });
      if (prevBtn) prevBtn.addEventListener('click', function () { prev(); startAutoplay(); });
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          goTo(parseInt(d.dataset.tstDot, 10) || 0);
          startAutoplay();
        });
      });
      if (playBtn) {
        playBtn.addEventListener('click', function () {
          if (isPlaying) { pauseAutoplay(); }
          else { startAutoplay(); }
        });
      }

      // ---- Teclado: flechas izq/der cuando el carrusel tiene el foco ----
      root.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); startAutoplay(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); startAutoplay(); }
      });

      // ---- Pausar autoplay en hover/focus dentro del carrusel ----
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', function () { if (isPlaying) startAutoplay(); });
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', function (e) {
        if (!root.contains(e.relatedTarget) && isPlaying) startAutoplay();
      });

      // ---- Pausar si la pestaña no está visible ----
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stopAutoplay(); }
        else if (isPlaying) { startAutoplay(); }
      });

      // ---- Swipe / drag con Pointer Events ----
      let dragging = false;
      let startX = 0;
      let deltaX = 0;
      let pointerId = null;

      function onPointerDown(e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        startX = e.clientX;
        deltaX = 0;
        pointerId = e.pointerId;
        viewport.classList.add('is-dragging');
        stopAutoplay();
        try { viewport.setPointerCapture(pointerId); } catch (err) {}
      }
      function onPointerMove(e) {
        if (!dragging) return;
        deltaX = e.clientX - startX;
        const width = viewport.offsetWidth || 1;
        const pct = (deltaX / width) * 100;
        track.style.transform = 'translateX(' + (-current * 100 + pct) + '%)';
      }
      function onPointerUp() {
        if (!dragging) return;
        dragging = false;
        viewport.classList.remove('is-dragging');
        const width = viewport.offsetWidth || 1;
        const threshold = width * 0.18;
        if (deltaX <= -threshold) { next(); }
        else if (deltaX >= threshold) { prev(); }
        else { render(); }
        deltaX = 0;
        if (isPlaying) startAutoplay();
        try { if (pointerId !== null) viewport.releasePointerCapture(pointerId); } catch (err) {}
        pointerId = null;
      }

      if (viewport && window.PointerEvent) {
        viewport.addEventListener('pointerdown', onPointerDown);
        viewport.addEventListener('pointermove', onPointerMove);
        viewport.addEventListener('pointerup', onPointerUp);
        viewport.addEventListener('pointercancel', onPointerUp);
        viewport.addEventListener('pointerleave', onPointerUp);
        // Evitar arrastrar imágenes/selección de texto al hacer swipe
        viewport.addEventListener('dragstart', function (e) { e.preventDefault(); });
      }

      // Reaccionar a cambios en la preferencia de movimiento en caliente
      if (typeof reduceMotion.addEventListener === 'function') {
        reduceMotion.addEventListener('change', function () {
          if (reduceMotion.matches) {
            pauseAutoplay();
            if (playBtn) playBtn.classList.add('hidden');
          } else {
            if (playBtn) playBtn.classList.remove('hidden');
            startAutoplay();
          }
        });
      }

      render();
      startAutoplay();
    }

    // ---- Botón "Copiar nuestro WhatsApp" ----
    function initCopy() {
      const btn = document.querySelector('[data-tst-copy]');
      const status = document.querySelector('[data-tst-copy-status]');
      if (!btn) return;
      const number = btn.dataset.waNumber || '';
      const isEn = function () { return document.documentElement.getAttribute('data-active-lang') === 'en'; };
      let resetId = null;

      function feedback(ok) {
        const icon = btn.querySelector('.tst-copy-icon');
        if (icon) icon.textContent = ok ? 'check' : 'error';
        if (status) {
          status.textContent = ok
            ? (isEn() ? 'WhatsApp number copied: ' + number : 'WhatsApp copiado: ' + number)
            : (isEn() ? 'Could not copy. Number: ' + number : 'No se pudo copiar. Número: ' + number);
        }
        if (resetId) window.clearTimeout(resetId);
        resetId = window.setTimeout(function () {
          if (icon) icon.textContent = 'content_copy';
          if (status) status.textContent = '';
        }, 2500);
      }

      function fallbackCopy(text) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (err) {
          return false;
        }
      }

      btn.addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(number).then(function () {
            feedback(true);
          }).catch(function () {
            feedback(fallbackCopy(number));
          });
        } else {
          feedback(fallbackCopy(number));
        }
      });
    }

    function init() {
      initCounters();
      initCarousel();
      initCopy();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
