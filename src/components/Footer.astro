---
const year = new Date().getFullYear();

// WhatsApp prefilled (reutilizados del sistema existente)
const WA_DIAG = 'https://wa.me/573194436045?text=Hola%20KANTECH!%20Quiero%20agendar%20mi%20diagn%C3%B3stico%20gratuito.';
const WA_GENERAL = 'https://wa.me/573194436045?text=Hola%2C%20me%20interesa%20conocer%20m%C3%A1s%20sobre%20los%20servicios%20de%20KANTECH';

const EMAIL = 'director@kantechsol.com';

const links = [
  { href: '#servicios',  es: 'Servicios',  en: 'Services' },
  { href: '#portafolio', es: 'Portafolio', en: 'Portfolio' },
  { href: '#proceso',    es: 'Proceso',    en: 'Process' },
  { href: '#nosotros',   es: 'Nosotros',   en: 'About' },
  { href: '#contacto',   es: 'Contacto',   en: 'Contact' },
];

const legal = [
  { href: '#', es: 'Política de privacidad', en: 'Privacy policy' },
  { href: '#', es: 'Términos',               en: 'Terms' },
];
---
<footer class="relative bg-surface-0 border-t border-border mt-20 pt-16 pb-8 overflow-hidden footer-gradient-top z-10">
  <!-- Resplandores de fondo -->
  <div class="absolute top-0 left-0 right-0 h-96 footer-radial-glow pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="absolute top-0 right-0 w-1/3 h-1/2 bg-accent/5 blur-[120px] rounded-full pointer-events-none -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-8">

    <!-- Banda de conversión final (top) -->
    <div class="flex flex-col md:flex-row items-center justify-between bg-surface-1/50 glass-panel border border-border rounded-2xl p-8 mb-16 shadow-2xl shadow-primary/5 hover:-translate-y-1 transition-transform duration-300 animate-fade-up" data-animate>
      <div class="mb-6 md:mb-0 text-center md:text-left">
        <h3 class="font-headline font-bold text-2xl md:text-3xl text-text mb-2">
          <span data-lang="es">Empieza por tu diagnóstico gratis</span>
          <span data-lang="en">Start with your free diagnosis</span>
        </h3>
        <div class="inline-flex items-center gap-2 bg-success/10 border border-success/30 rounded-full px-3 py-1 mt-2">
          <span class="w-2 h-2 rounded-full bg-success animate-pulse" aria-hidden="true"></span>
          <span class="text-success text-xs font-semibold uppercase tracking-wider">
            <span data-lang="es">Responde en &lt; 1h</span>
            <span data-lang="en">Replies in &lt; 1h</span>
          </span>
        </div>
      </div>
      <a href={WA_DIAG} target="_blank" rel="noopener"
         class="btn-primary text-base px-8 py-4 group">
        <span data-lang="es">Agenda tu diagnóstico</span>
        <span data-lang="en">Book your diagnosis</span>
        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform" aria-hidden="true">arrow_forward</span>
      </a>
    </div>

    <!-- Footer principal (4 columnas) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 mb-16">

      <!-- Col 1 (Marca) -->
      <div class="lg:col-span-4 flex flex-col animate-fade-up delay-100" data-animate>
        <a href="/" class="flex items-center gap-3 mb-6 group" aria-label="KANTECH inicio">
          <div class="w-9 h-9 rounded-lg bg-brand-gradient flex items-center justify-center shadow-lg shadow-primary/20 group-hover:shadow-primary/40 transition-all duration-300">
            <span class="font-display font-bold text-lg text-white leading-none">K</span>
          </div>
          <span class="font-headline font-bold text-2xl tracking-tight text-text">KANTECH</span>
        </a>
        <p class="text-muted text-sm leading-relaxed mb-8 max-w-sm">
          <span data-lang="es">Agentes de IA, automatizaciones y desarrollo a medida para empresas en crecimiento.</span>
          <span data-lang="en">AI agents, automations, and custom software for growing businesses.</span>
        </p>
        <!-- Redes sociales -->
        <div class="flex items-center gap-4">
          <a href="https://www.linkedin.com/in/diegoalpala/" target="_blank" rel="noopener" aria-label="LinkedIn"
             class="w-10 h-10 rounded-full bg-surface-1 border border-border flex items-center justify-center text-muted hover:text-text hover:bg-primary/20 hover:border-primary/50 transition-all duration-300 hover:-translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/Dfa2823" target="_blank" rel="noopener" aria-label="GitHub"
             class="w-10 h-10 rounded-full bg-surface-1 border border-border flex items-center justify-center text-muted hover:text-text hover:bg-primary/20 hover:border-primary/50 transition-all duration-300 hover:-translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a href={WA_GENERAL} target="_blank" rel="noopener" aria-label="WhatsApp"
             class="w-10 h-10 rounded-full bg-surface-1 border border-border flex items-center justify-center text-muted hover:text-success hover:bg-success/20 hover:border-success/50 transition-all duration-300 hover:-translate-y-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.558 4.122 1.532 5.854L.057 23.886a.5.5 0 0 0 .613.613l6.033-1.475A11.955 11.955 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.88 0-3.641-.516-5.148-1.413l-.369-.214-3.822.936.955-3.822-.237-.383A9.963 9.963 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2 (Navegación) -->
      <div class="lg:col-span-2 animate-fade-up delay-200" data-animate>
        <h4 class="font-headline font-semibold text-text mb-6 uppercase tracking-wider text-sm">
          <span data-lang="es">Navegación</span>
          <span data-lang="en">Navigation</span>
        </h4>
        <ul class="flex flex-col gap-4">
          {links.map(l => (
            <li>
              <a href={l.href} class="text-muted hover:text-text hover:translate-x-1 transition-all inline-block text-sm">
                <span data-lang="es">{l.es}</span>
                <span data-lang="en">{l.en}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3 (Contacto directo) -->
      <div class="lg:col-span-3 animate-fade-up delay-300" data-animate>
        <h4 class="font-headline font-semibold text-text mb-6 uppercase tracking-wider text-sm">
          <span data-lang="es">Contacto directo</span>
          <span data-lang="en">Direct contact</span>
        </h4>
        <ul class="flex flex-col gap-4">
          <li class="flex items-center gap-3 text-muted text-sm group">
            <span class="material-symbols-outlined text-border group-hover:text-primary transition-colors text-lg" aria-hidden="true">call</span>
            <a class="hover:text-text transition-colors" href="tel:+573194436045">+57 319 443 6045</a>
          </li>
          <li class="flex items-center gap-3 text-muted text-sm group">
            <span class="material-symbols-outlined text-border group-hover:text-primary transition-colors text-lg" aria-hidden="true">mail</span>
            <a class="hover:text-text transition-colors break-all" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </li>
          <li class="flex items-center gap-3 text-muted text-sm mt-2 p-3 bg-surface-1/50 rounded-lg border border-border">
            <span class="material-symbols-outlined text-accent text-lg" style="font-variation-settings:'FILL' 1;" aria-hidden="true">location_on</span>
            <span data-lang="es">Cali, Colombia · Disponible LatAm</span>
            <span data-lang="en">Cali, Colombia · Available LatAm</span>
          </li>
        </ul>
      </div>

      <!-- Col 4 (Legal + controles) -->
      <div class="lg:col-span-3 flex flex-col justify-between h-full animate-fade-up delay-400" data-animate>
        <div>
          <h4 class="font-headline font-semibold text-text mb-6 uppercase tracking-wider text-sm">
            <span data-lang="es">Legal</span>
            <span data-lang="en">Legal</span>
          </h4>
          <ul class="flex flex-col gap-4 mb-8">
            {legal.map(l => (
              <li>
                <a href={l.href} class="text-muted hover:text-text transition-colors text-sm">
                  <span data-lang="es">{l.es}</span>
                  <span data-lang="en">{l.en}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex items-center justify-between lg:justify-start lg:gap-6">
          <!-- Switch ES|EN (sigue el estado global de idioma) -->
          <div class="relative flex items-center bg-surface-1 rounded-lg p-1 border border-border shadow-inner" id="footer-lang-switch">
            <div class="lang-indicator absolute left-1 top-1 bottom-1 w-[calc(50%-4px)] bg-surface-3 rounded-md shadow-sm border border-white/5"></div>
            <button onclick="setLang('es')" data-lang-btn="es" class="lang-opt relative z-10 px-3 py-1 text-xs font-semibold rounded-md transition-colors" aria-label="Español">ES</button>
            <button onclick="setLang('en')" data-lang-btn="en" class="lang-opt relative z-10 px-3 py-1 text-xs font-semibold rounded-md transition-colors" aria-label="English">EN</button>
          </div>
          <!-- Volver arriba -->
          <button type="button" id="footer-to-top" class="flex items-center gap-2 text-muted hover:text-accent transition-colors group text-sm font-medium">
            <span data-lang="es">Volver arriba</span>
            <span data-lang="en">Back to top</span>
            <span class="material-symbols-outlined w-8 h-8 rounded-full bg-surface-1 border border-border flex items-center justify-center group-hover:border-accent/50 group-hover:bg-accent/10 transition-all group-hover:-translate-y-1" aria-hidden="true">arrow_upward</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-muted text-xs font-body text-center md:text-left">
        © {year} KANTECH.
        <span data-lang="es">Todos los derechos reservados. · Hecho con precisión en Colombia 🇨🇴</span>
        <span data-lang="en">All rights reserved. · Crafted with precision in Colombia 🇨🇴</span>
      </p>
      <div class="flex items-center gap-2 opacity-50 hover:opacity-100 transition-opacity cursor-default">
        <span class="w-1.5 h-1.5 rounded-full bg-success" aria-hidden="true"></span>
        <span class="text-[10px] text-muted uppercase tracking-widest font-mono">
          <span data-lang="es">Sistemas operativos</span>
          <span data-lang="en">Systems operational</span>
        </span>
      </div>
    </div>
  </div>
</footer>

<style is:global>
  /* Hairline de gradiente superior del footer */
  .footer-gradient-top { position: relative; }
  .footer-gradient-top::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, #1E3BFF, #00D4FF, #6C2FD9);
  }
  /* Resplandor radial de fondo del footer */
  .footer-radial-glow {
    background: radial-gradient(circle at 50% 0%, rgba(30, 59, 255, 0.15) 0%, rgba(8, 11, 22, 0) 70%);
  }
  /* El switch del footer reutiliza .lang-indicator / .lang-opt (definidos por el Navbar):
     el indicador se desplaza solo via html[data-active-lang]. */
</style>

<script is:inline>
  (function () {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const toTop = document.getElementById('footer-to-top');
    if (toTop) {
      toTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }
  })();
</script>
