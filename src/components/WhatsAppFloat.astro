---
// Widget flotante de WhatsApp (no es <section>). Fijo en la esquina inferior derecha.
// Número y mensajes prellenados preservados del componente original.
const WA_NUMBER = '573194436045';
const replies = [
  { intent: 'diagnostico', icon: 'arrow_forward', es: 'Quiero un diagnóstico gratis', en: 'I want a free diagnosis' },
  { intent: 'cotizacion',  icon: 'request_quote', es: 'Necesito una cotización',      en: 'I need a quote' },
  { intent: 'duda',        icon: 'help',          es: 'Tengo una pregunta',           en: 'I have a question' },
];
---
<!-- WhatsApp Widget Container -->
<div id="wa-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-4 pointer-events-none animate-fade-up" data-animate>
  <!-- Chat Panel (oculto inicialmente) -->
  <div
    id="wa-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat de WhatsApp con KANTECH"
    aria-hidden="true"
    class="hidden w-80 sm:w-96 glass-panel rounded-xl flex-col overflow-hidden pointer-events-auto transform origin-bottom-right transition-all duration-300 scale-95 translate-y-5 opacity-0 shadow-2xl shadow-black/50"
  >
    <!-- Header -->
    <div class="wa-header-gradient p-4 flex items-center gap-3 relative shadow-md z-10">
      <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center flex-shrink-0 shadow-inner">
        <span class="font-display font-bold text-xl text-[#128C7E]">K</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="font-display font-bold text-white text-base leading-tight">KANTECH</h3>
        <div class="flex items-center gap-1.5 mt-0.5" id="wa-status">
          <!-- Poblado por JS según horario -->
        </div>
      </div>
      <button id="wa-close" aria-label="Cerrar chat" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors text-white focus-visible:outline-2 focus-visible:outline-white">
        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Body -->
    <div class="wa-body h-64 p-4 overflow-y-auto wa-no-scrollbar flex flex-col gap-3 relative">
      <!-- Indicador de escritura (estado inicial) -->
      <div id="wa-typing" class="bg-white text-gray-800 rounded-lg rounded-tl-none p-3 max-w-[80%] shadow-sm self-start w-16 h-10 flex items-center justify-center gap-1" aria-hidden="true">
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0s;"></div>
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0.2s;"></div>
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0.4s;"></div>
      </div>

      <!-- Mensaje real (oculto inicialmente) -->
      <div id="wa-message" class="hidden bg-white text-gray-800 rounded-lg rounded-tl-none p-3 max-w-[85%] shadow-sm self-start wa-slide-up">
        <p class="text-[15px] leading-snug" data-lang="es">¡Hola! 👋 Bienvenido a <strong>KANTECH</strong>.<br/>¿Qué te gustaría resolver hoy?</p>
        <p class="text-[15px] leading-snug" data-lang="en">Hi! 👋 Welcome to <strong>KANTECH</strong>.<br/>What would you like to solve today?</p>
        <span class="text-[10px] text-gray-400 block text-right mt-1" id="wa-msg-time"></span>
      </div>

      <!-- Respuestas rápidas -->
      <div id="wa-quick-replies" class="hidden flex-col gap-2 mt-2 wa-slide-up" style="animation-delay:0.15s;">
        {replies.map(r => (
          <button
            type="button"
            data-wa-intent={r.intent}
            class="wa-chip bg-surface-1/90 text-sm font-medium border border-border rounded-lg px-4 py-2.5 text-left text-text shadow-sm flex items-center justify-between gap-2 group focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span><span data-lang="es">{r.es}</span><span data-lang="en">{r.en}</span></span>
            <span class="material-symbols-outlined text-muted group-hover:text-accent text-[18px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">{r.icon}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Footer -->
    <div class="bg-surface-1 p-3 border-t border-border flex justify-center items-center">
      <p class="text-xs text-muted flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">schedule</span>
        <span data-lang="es">Lun-Vie 8am-7pm COT</span>
        <span data-lang="en">Mon-Fri 8am-7pm COT</span>
      </p>
    </div>
  </div>

  <!-- FAB + Peek Bubble -->
  <div class="flex items-center gap-4 pointer-events-auto relative">
    <!-- Peek Bubble (descartable) -->
    <div id="wa-peek" class="hidden bg-surface-2 text-text text-sm font-medium px-4 py-2.5 rounded-lg border border-border shadow-lg relative cursor-pointer hover:bg-surface-3 transition-colors pr-8 wa-slide-bounce">
      <span data-lang="es">Hola 👋 ¿te ayudo?</span>
      <span data-lang="en">Hi 👋 can I help?</span>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-2 h-2 bg-surface-2 border-r border-t border-border" style="transform:translate(50%,-50%) rotate(45deg);"></div>
      <button id="wa-peek-close" type="button" aria-label="Descartar mensaje" class="absolute right-2 top-1/2 -translate-y-1/2 text-muted hover:text-text p-0.5 focus-visible:outline-2 focus-visible:outline-primary">
        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- FAB -->
    <button
      id="wa-fab"
      type="button"
      aria-label="Abrir chat de WhatsApp"
      aria-expanded="false"
      aria-controls="wa-panel"
      class="w-14 h-14 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 active:scale-95 wa-breathe z-50 group text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
      style="background-color:#25D366; box-shadow:0 10px 25px -5px rgba(37,211,102,0.35);"
    >
      <svg class="transform group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.558 4.122 1.532 5.854L.057 23.886a.5.5 0 0 0 .613.613l6.033-1.475A11.955 11.955 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.88 0-3.641-.516-5.148-1.413l-.369-.214-3.822.936.955-3.822-.237-.383A9.963 9.963 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /* Degradado de marca WhatsApp para la cabecera del panel */
  .wa-header-gradient { background: linear-gradient(135deg, #128C7E 0%, #25D366 100%); }
  /* Fondo tipo WhatsApp para el cuerpo del chat */
  .wa-body {
    background-color: #EFEAE2;
    background-image: url("data:image/svg+xml,%3Csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='wa-bg' x='0' y='0' width='100' height='100' patternUnits='userSpaceOnUse'%3E%3Cpath d='M20 20h2v2h-2zM40 40h2v2h-2zM60 20h2v2h-2zM80 60h2v2h-2zM20 80h2v2h-2z' fill='%23000' fill-opacity='0.03'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100%25' height='100%25' fill='url(%23wa-bg)'/%3E%3C/svg%3E");
  }
  /* Ocultar scrollbar del cuerpo del chat */
  .wa-no-scrollbar::-webkit-scrollbar { display: none; }
  .wa-no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Hover de los chips de respuesta rápida */
  .wa-chip { transition: all 0.2s ease; }
  .wa-chip:hover {
    transform: translateY(-2px);
    background: rgba(30, 59, 255, 0.1);
    border-color: rgba(30, 59, 255, 0.3);
    color: #00D4FF;
  }

  /* Animaciones del widget */
  @keyframes waBreathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4), 0 10px 25px -5px rgba(37,211,102,0.35); }
    50%      { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0), 0 10px 25px -5px rgba(37,211,102,0.35); }
  }
  @keyframes waSlideUp {
    0%   { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes waBounceDot {
    0%, 80%, 100% { transform: scale(0); }
    40%           { transform: scale(1); }
  }
  @keyframes waSlideBounce {
    0%   { transform: translateX(100px); opacity: 0; }
    60%  { transform: translateX(-10px); opacity: 1; }
    100% { transform: translateX(0); opacity: 1; }
  }
  .wa-breathe { animation: waBreathe 2s infinite ease-in-out; }
  .wa-slide-up { animation: waSlideUp 0.3s ease-out forwards; }
  .wa-bounce { animation: waBounceDot 1.4s infinite ease-in-out both; }
  .wa-slide-bounce { animation: waSlideBounce 0.5s ease-out forwards; }

  @media (prefers-reduced-motion: reduce) {
    .wa-breathe, .wa-slide-up, .wa-bounce, .wa-slide-bounce { animation: none !important; }
    #wa-panel { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var widget = document.getElementById('wa-widget');
    var panel = document.getElementById('wa-panel');
    var fab = document.getElementById('wa-fab');
    var closeBtn = document.getElementById('wa-close');
    var peek = document.getElementById('wa-peek');
    var peekClose = document.getElementById('wa-peek-close');
    var statusEl = document.getElementById('wa-status');
    var typing = document.getElementById('wa-typing');
    var message = document.getElementById('wa-message');
    var quick = document.getElementById('wa-quick-replies');
    var msgTime = document.getElementById('wa-msg-time');

    if (!widget || !fab || !panel) return;

    var WA_NUMBER = '573194436045';
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Mensajes prellenados (preservados del componente original)
    var messages = {
      diagnostico: 'Hola KANTECH! Quiero agendar mi diagnóstico gratuito.',
      cotizacion: 'Hola KANTECH! Necesito una cotización para un proyecto.',
      duda: 'Hola KANTECH! Tengo una pregunta sobre sus servicios.'
    };
    function openWA(intent) {
      var text = messages[intent] || messages.diagnostico;
      window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text), '_blank', 'noopener');
    }

    // Hora del mensaje inicial
    if (msgTime) {
      try {
        msgTime.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      } catch (e) { /* noop */ }
    }

    // Estado de horario (Lun-Vie 8:00–19:00 COT)
    function updateStatus() {
      if (!statusEl) return;
      var inHours = false;
      try {
        var cot = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Bogota' }));
        var day = cot.getDay();   // 0 = domingo
        var hour = cot.getHours();
        inHours = (day >= 1 && day <= 5) && (hour >= 8 && hour < 19);
      } catch (e) { inHours = false; }

      // Los spans [data-lang] son gestionados automáticamente por el CSS global
      // (html[data-active-lang] ...), no requieren JS adicional.
      if (inHours) {
        statusEl.innerHTML =
          '<span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>' +
          '<span class="text-xs text-white/90 font-medium" data-lang="es">En línea</span>' +
          '<span class="text-xs text-white/90 font-medium" data-lang="en">Online</span>';
      } else {
        statusEl.innerHTML =
          '<span class="w-2 h-2 rounded-full bg-gray-400"></span>' +
          '<span class="text-[11px] text-white/80" data-lang="es">Fuera de horario · respondemos pronto</span>' +
          '<span class="text-[11px] text-white/80" data-lang="en">Offline · we reply soon</span>';
      }
    }
    updateStatus();

    var isOpen = false;
    var messageShown = false;

    function hidePeek(persist) {
      if (!peek) return;
      peek.classList.add('hidden');
      peek.classList.remove('flex');
      if (persist) {
        try { sessionStorage.setItem('waPeekHidden', 'true'); } catch (e) { /* noop */ }
      }
    }

    function openChat() {
      isOpen = true;
      hidePeek(true);
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      panel.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');
      fab.classList.remove('wa-breathe');

      var reveal = function () {
        panel.classList.remove('scale-95', 'translate-y-5', 'opacity-0');
        panel.classList.add('scale-100', 'translate-y-0', 'opacity-100');
      };
      if (reduceMotion) { reveal(); } else { requestAnimationFrame(reveal); }

      // Mover el foco al botón de cerrar para accesibilidad
      if (closeBtn) closeBtn.focus();

      // Simular escritura -> mensaje + respuestas (una sola vez)
      if (!messageShown) {
        messageShown = true;
        var showMessage = function () {
          if (typing) typing.classList.add('hidden');
          if (message) message.classList.remove('hidden');
          if (quick) { quick.classList.remove('hidden'); quick.classList.add('flex'); }
        };
        if (reduceMotion) { showMessage(); } else { setTimeout(showMessage, 1500); }
      }
    }

    function closeChat(returnFocus) {
      isOpen = false;
      fab.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      panel.classList.remove('scale-100', 'translate-y-0', 'opacity-100');
      panel.classList.add('scale-95', 'translate-y-5', 'opacity-0');

      var finish = function () {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        fab.classList.add('wa-breathe');
      };
      if (reduceMotion) { finish(); } else { setTimeout(finish, 300); }
      if (returnFocus) fab.focus();
    }

    function toggleChat() { isOpen ? closeChat(true) : openChat(); }

    fab.addEventListener('click', toggleChat);
    if (closeBtn) closeBtn.addEventListener('click', function () { closeChat(true); });
    if (peek) peek.addEventListener('click', openChat);
    if (peekClose) peekClose.addEventListener('click', function (e) { e.stopPropagation(); hidePeek(true); });

    // Respuestas rápidas -> abrir WhatsApp
    widget.querySelectorAll('[data-wa-intent]').forEach(function (btn) {
      btn.addEventListener('click', function () { openWA(btn.getAttribute('data-wa-intent')); });
    });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', function (e) {
      if (isOpen && !e.target.closest('#wa-widget')) closeChat(false);
    });

    // ESC para cerrar
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) closeChat(true);
    });

    // Mostrar peek bubble tras 2s (salvo que se haya descartado en la sesión)
    var peekHidden = false;
    try { peekHidden = sessionStorage.getItem('waPeekHidden') === 'true'; } catch (e) { /* noop */ }
    if (peek && !peekHidden) {
      setTimeout(function () {
        if (!isOpen && peek.classList.contains('hidden')) {
          peek.classList.remove('hidden');
          peek.classList.add('flex');
        }
      }, 2000);
    }
  })();
</script>
