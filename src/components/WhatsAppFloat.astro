---
// Widget flotante de WhatsApp (no es <section>). Fijo en la esquina inferior derecha.
// Número y mensajes prellenados preservados del componente original.
const WA_NUMBER = '573194436045';
const replies = [
  { intent: 'diagnostico', icon: 'arrow_forward', es: 'Quiero un diagnóstico gratis', en: 'I want a free diagnosis' },
  { intent: 'cotizacion',  icon: 'request_quote', es: 'Necesito una cotización',      en: 'I need a quote' },
  { intent: 'duda',        icon: 'help',          es: 'Tengo una pregunta',           en: 'I have a question' },
];
// Sub-opciones del mini-flujo: tras elegir intención, refinamos el área para un lead más específico.
const subTopics = [
  { topic: 'ia',  icon: 'smart_toy',          es: 'Agentes de IA',          en: 'AI Agents' },
  { topic: 'n8n', icon: 'account_tree',       es: 'Automatizaciones (N8N)', en: 'Automations (N8N)' },
  { topic: 'web', icon: 'code',               es: 'Software / Web a medida', en: 'Custom Software / Web' },
];
---
<!-- WhatsApp Widget Container -->
<div id="wa-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-4 pointer-events-none animate-fade-up" data-animate>
  <!-- Chat Panel (oculto inicialmente) -->
  <div
    id="wa-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Chat de WhatsApp con KANTECH"
    aria-hidden="true"
    class="hidden w-80 sm:w-96 glass-panel rounded-xl flex-col overflow-hidden pointer-events-auto transform origin-bottom-right transition-all duration-300 scale-95 translate-y-5 opacity-0 shadow-2xl shadow-black/50"
  >
    <!-- Header -->
    <div class="wa-header-gradient p-4 flex items-center gap-3 relative shadow-md z-10">
      <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center flex-shrink-0 shadow-inner">
        <span class="font-display font-bold text-xl text-[#128C7E]">K</span>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="font-display font-bold text-white text-base leading-tight">KANTECH</h3>
        <div class="flex items-center gap-1.5 mt-0.5" id="wa-status" aria-live="polite">
          <!-- Poblado por JS según horario -->
        </div>
      </div>
      <button id="wa-close" aria-label="Cerrar chat" class="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors text-white focus-visible:outline-2 focus-visible:outline-white">
        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- Body -->
    <div class="wa-body h-64 p-4 overflow-y-auto wa-no-scrollbar flex flex-col gap-3 relative">
      <!-- Indicador de escritura (estado inicial) -->
      <div id="wa-typing" class="bg-white text-gray-800 rounded-lg rounded-tl-none p-3 max-w-[80%] shadow-sm self-start w-16 h-10 flex items-center justify-center gap-1" aria-hidden="true">
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0s;"></div>
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0.2s;"></div>
        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full wa-bounce" style="animation-delay:0.4s;"></div>
      </div>

      <!-- Mensaje real (oculto inicialmente) -->
      <div id="wa-message" class="hidden bg-white text-gray-800 rounded-lg rounded-tl-none p-3 max-w-[85%] shadow-sm self-start wa-slide-up">
        <p class="text-[15px] leading-snug" data-lang="es">¡Hola! 👋 Bienvenido a <strong>KANTECH</strong>.<br/>¿Qué te gustaría resolver hoy?</p>
        <p class="text-[15px] leading-snug" data-lang="en">Hi! 👋 Welcome to <strong>KANTECH</strong>.<br/>What would you like to solve today?</p>
        <span class="text-[10px] text-gray-400 block text-right mt-1" id="wa-msg-time"></span>
      </div>

      <!-- Paso 1: Respuestas rápidas (intención) -->
      <div id="wa-quick-replies" class="hidden flex-col gap-2 mt-2 wa-slide-up" style="animation-delay:0.15s;">
        {replies.map(r => (
          <button
            type="button"
            data-wa-intent={r.intent}
            class="wa-chip bg-surface-1/90 text-sm font-medium border border-border rounded-lg px-4 py-2.5 text-left text-text shadow-sm flex items-center justify-between gap-2 group focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span><span data-lang="es">{r.es}</span><span data-lang="en">{r.en}</span></span>
            <span class="material-symbols-outlined text-muted group-hover:text-accent text-[18px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">{r.icon}</span>
          </button>
        ))}
      </div>

      <!-- Paso 2: Sub-opciones (área) — visible tras elegir intención -->
      <div id="wa-subtopics" class="hidden flex-col gap-2 mt-2 wa-slide-up" style="animation-delay:0.05s;" aria-hidden="true">
        <p class="text-[13px] text-muted px-1">
          <span data-lang="es">¿Sobre qué te interesa?</span>
          <span data-lang="en">What are you interested in?</span>
        </p>
        {subTopics.map(s => (
          <button
            type="button"
            data-wa-topic={s.topic}
            class="wa-chip bg-surface-1/90 text-sm font-medium border border-border rounded-lg px-4 py-2.5 text-left text-text shadow-sm flex items-center justify-between gap-2 group focus-visible:outline-2 focus-visible:outline-primary"
          >
            <span><span data-lang="es">{s.es}</span><span data-lang="en">{s.en}</span></span>
            <span class="material-symbols-outlined text-muted group-hover:text-accent text-[18px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">{s.icon}</span>
          </button>
        ))}
        <button
          type="button"
          id="wa-back"
          class="text-xs text-muted hover:text-accent self-start mt-1 flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-primary rounded"
        >
          <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">arrow_back</span>
          <span data-lang="es">Volver</span>
          <span data-lang="en">Back</span>
        </button>
      </div>

      <!-- Estado offline: CTA alternativo (oculto por defecto) -->
      <div id="wa-offline-cta" class="hidden mt-2 wa-slide-up">
        <a
          href="#contacto"
          id="wa-offline-link"
          class="block bg-surface-1/90 text-sm font-medium border border-dashed border-primary/40 rounded-lg px-4 py-2.5 text-left text-text shadow-sm flex items-center justify-between gap-2 group focus-visible:outline-2 focus-visible:outline-primary hover:border-primary/70 transition-colors"
        >
          <span>
            <span data-lang="es">Déjanos tus datos y te escribimos al abrir</span>
            <span data-lang="en">Leave your details, we'll reach out when we open</span>
          </span>
          <span class="material-symbols-outlined text-muted group-hover:text-accent text-[18px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">mail</span>
        </a>
      </div>
    </div>

    <!-- Footer: input de texto libre real -->
    <form id="wa-form" class="bg-surface-1 p-3 border-t border-border flex flex-col gap-2">
      <div class="flex items-center gap-2">
        <label for="wa-input" class="sr-only">
          <span data-lang="es">Escribe tu mensaje</span>
          <span data-lang="en">Type your message</span>
        </label>
        <input
          id="wa-input"
          name="wa-input"
          type="text"
          autocomplete="off"
          maxlength="280"
          data-placeholder-es="Escribe tu mensaje…"
          data-placeholder-en="Type your message…"
          placeholder="Escribe tu mensaje…"
          class="flex-1 min-w-0 bg-surface-0 text-text text-sm rounded-lg border border-border px-3 py-2 placeholder:text-muted focus-visible:outline-2 focus-visible:outline-primary focus:border-primary/50 transition-colors"
        />
        <button
          id="wa-send"
          type="submit"
          aria-label="Enviar mensaje por WhatsApp"
          class="w-9 h-9 flex-shrink-0 rounded-lg flex items-center justify-center text-[#07101F] transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          style="background-color:#6AC3C6;"
        >
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings:'FILL' 1;" aria-hidden="true">send</span>
        </button>
      </div>
      <p class="text-[11px] text-muted flex items-center gap-1.5 justify-center">
        <span class="material-symbols-outlined text-[13px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">schedule</span>
        <span data-lang="es">Lun-Vie 8am-7pm COT</span>
        <span data-lang="en">Mon-Fri 8am-7pm COT</span>
      </p>
    </form>
  </div>

  <!-- FAB + Peek Bubble -->
  <div class="flex items-center gap-4 pointer-events-auto relative">
    <!-- Peek Bubble (descartable) -->
    <div id="wa-peek" class="hidden bg-surface-2 text-text text-sm font-medium px-4 py-2.5 rounded-lg border border-border shadow-lg relative cursor-pointer hover:bg-surface-3 transition-colors pr-8 wa-slide-bounce">
      <span data-lang="es">Hola 👋 ¿te ayudo?</span>
      <span data-lang="en">Hi 👋 can I help?</span>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-2 h-2 bg-surface-2 border-r border-t border-border" style="transform:translate(50%,-50%) rotate(45deg);"></div>
      <button id="wa-peek-close" type="button" aria-label="Descartar mensaje" class="absolute right-2 top-1/2 -translate-y-1/2 text-muted hover:text-text p-0.5 focus-visible:outline-2 focus-visible:outline-primary">
        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 0;" aria-hidden="true">close</span>
      </button>
    </div>

    <!-- FAB -->
    <button
      id="wa-fab"
      type="button"
      aria-label="Abrir chat de WhatsApp"
      aria-expanded="false"
      aria-controls="wa-panel"
      class="w-14 h-14 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 active:scale-95 wa-breathe z-50 group text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
      style="background-color:#25D366; box-shadow:0 10px 25px -5px rgba(37,211,102,0.35);"
    >
      <svg class="transform group-hover:scale-110 transition-transform" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.558 4.122 1.532 5.854L.057 23.886a.5.5 0 0 0 .613.613l6.033-1.475A11.955 11.955 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.88 0-3.641-.516-5.148-1.413l-.369-.214-3.822.936.955-3.822-.237-.383A9.963 9.963 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /* Degradado de marca WhatsApp para la cabecera del panel */
  .wa-header-gradient { background: linear-gradient(135deg, #128C7E 0%, #25D366 100%); }
  /* Fondo tipo WhatsApp para el cuerpo del chat */
  .wa-body {
    background-color: #EFEAE2;
    background-image: url("data:image/svg+xml,%3Csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='wa-bg' x='0' y='0' width='100' height='100' patternUnits='userSpaceOnUse'%3E%3Cpath d='M20 20h2v2h-2zM40 40h2v2h-2zM60 20h2v2h-2zM80 60h2v2h-2zM20 80h2v2h-2z' fill='%23000' fill-opacity='0.03'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100%25' height='100%25' fill='url(%23wa-bg)'/%3E%3C/svg%3E");
  }
  /* Ocultar scrollbar del cuerpo del chat */
  .wa-no-scrollbar::-webkit-scrollbar { display: none; }
  .wa-no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Hover de los chips de respuesta rápida */
  .wa-chip { transition: all 0.2s ease; }
  .wa-chip:hover {
    transform: translateY(-2px);
    background: rgba(106,195,198, 0.1);
    border-color: rgba(106,195,198, 0.3);
    color: #6AC3C6;
  }
  /* Feedback de pulsado al abrir WhatsApp */
  .wa-chip:active { transform: scale(0.98); }
  /* Estado "abriendo WhatsApp" del chip */
  .wa-chip.is-opening {
    background: rgba(106,195,198, 0.15);
    border-color: rgba(106,195,198, 0.5);
    color: #6AC3C6;
    pointer-events: none;
  }

  /* Animaciones del widget */
  @keyframes waBreathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.4), 0 10px 25px -5px rgba(37,211,102,0.35); }
    50%      { box-shadow: 0 0 0 15px rgba(37, 211, 102, 0), 0 10px 25px -5px rgba(37,211,102,0.35); }
  }
  @keyframes waSlideUp {
    0%   { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes waBounceDot {
    0%, 80%, 100% { transform: scale(0); }
    40%           { transform: scale(1); }
  }
  @keyframes waSlideBounce {
    0%   { transform: translateX(100px); opacity: 0; }
    60%  { transform: translateX(-10px); opacity: 1; }
    100% { transform: translateX(0); opacity: 1; }
  }
  /* El pulso del FAB se detiene tras la primera interacción/scroll (clase añadida por JS) */
  .wa-breathe { animation: waBreathe 2s infinite ease-in-out; }
  .wa-breathe.wa-rest { animation: none; }
  .wa-slide-up { animation: waSlideUp 0.3s ease-out forwards; }
  .wa-bounce { animation: waBounceDot 1.4s infinite ease-in-out both; }
  .wa-slide-bounce { animation: waSlideBounce 0.5s ease-out forwards; }

  @media (prefers-reduced-motion: reduce) {
    .wa-breathe, .wa-slide-up, .wa-bounce, .wa-slide-bounce { animation: none !important; }
    #wa-panel { transition: none !important; }
    .wa-chip { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    var widget = document.getElementById('wa-widget');
    var panel = document.getElementById('wa-panel');
    var fab = document.getElementById('wa-fab');
    var closeBtn = document.getElementById('wa-close');
    var peek = document.getElementById('wa-peek');
    var peekClose = document.getElementById('wa-peek-close');
    var statusEl = document.getElementById('wa-status');
    var typing = document.getElementById('wa-typing');
    var message = document.getElementById('wa-message');
    var quick = document.getElementById('wa-quick-replies');
    var subtopics = document.getElementById('wa-subtopics');
    var backBtn = document.getElementById('wa-back');
    var offlineCta = document.getElementById('wa-offline-cta');
    var msgTime = document.getElementById('wa-msg-time');
    var form = document.getElementById('wa-form');
    var input = document.getElementById('wa-input');
    var sendBtn = document.getElementById('wa-send');

    if (!widget || !fab || !panel) return;

    var WA_NUMBER = '573194436045';
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function isEn() { return document.documentElement.getAttribute('data-active-lang') === 'en'; }

    function openWhatsApp(text) {
      window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text), '_blank', 'noopener');
    }

    // --- Mini-flujo: intención + área -> mensaje específico ---
    // Mensajes base por intención (preservados del componente original).
    var intentMessages = {
      diagnostico: { es: 'Hola KANTECH! Quiero agendar mi diagnóstico gratuito.', en: 'Hi KANTECH! I want to schedule my free diagnosis.' },
      cotizacion:  { es: 'Hola KANTECH! Necesito una cotización para un proyecto.', en: 'Hi KANTECH! I need a quote for a project.' },
      duda:        { es: 'Hola KANTECH! Tengo una pregunta sobre sus servicios.', en: 'Hi KANTECH! I have a question about your services.' }
    };
    // Refinamiento por área (paso 2).
    var topicLabels = {
      ia:  { es: 'Agentes de IA', en: 'AI Agents' },
      n8n: { es: 'Automatizaciones con N8N', en: 'N8N automations' },
      web: { es: 'Software / Web a medida', en: 'Custom software / web' }
    };
    var pendingIntent = null;

    function buildMessage(intent, topic) {
      var en = isEn();
      var base = (intentMessages[intent] || intentMessages.diagnostico);
      var msg = en ? base.en : base.es;
      if (topic && topicLabels[topic]) {
        var lbl = en ? topicLabels[topic].en : topicLabels[topic].es;
        msg += en ? (' Specifically about: ' + lbl + '.') : (' En concreto sobre: ' + lbl + '.');
      }
      return msg;
    }

    // Hora del mensaje inicial
    if (msgTime) {
      try {
        msgTime.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      } catch (e) { /* noop */ }
    }

    // --- Estado de horario (Lun-Vie 8:00–19:00 COT) ---
    var isOnline = false;
    function computeOnline() {
      try {
        var cot = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Bogota' }));
        var day = cot.getDay();   // 0 = domingo
        var hour = cot.getHours();
        return (day >= 1 && day <= 5) && (hour >= 8 && hour < 19);
      } catch (e) { return false; }
    }
    function updateStatus() {
      if (!statusEl) return;
      isOnline = computeOnline();
      // Los spans [data-lang] son gestionados automáticamente por el CSS global.
      if (isOnline) {
        statusEl.innerHTML =
          '<span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>' +
          '<span class="text-xs text-white/90 font-medium" data-lang="es">En línea</span>' +
          '<span class="text-xs text-white/90 font-medium" data-lang="en">Online</span>';
      } else {
        statusEl.innerHTML =
          '<span class="w-2 h-2 rounded-full bg-gray-400"></span>' +
          '<span class="text-[11px] text-white/80" data-lang="es">Fuera de horario · respondemos pronto</span>' +
          '<span class="text-[11px] text-white/80" data-lang="en">Offline · we reply soon</span>';
      }
      // CTA alternativo solo cuando estamos fuera de horario.
      if (offlineCta) offlineCta.classList.toggle('hidden', isOnline);
    }
    updateStatus();
    // Recalcular periódicamente (la pestaña puede cruzar las 19:00 abierta).
    setInterval(updateStatus, 60000);

    // --- Estado del panel ---
    var isOpen = false;
    var messageShown = false;
    var typingTimer = null;          // id del setTimeout del typing (limpiable)
    var lastFocused = null;          // foco a restaurar al cerrar
    var pulseStopped = false;

    function stopPulse() {
      if (pulseStopped) return;
      pulseStopped = true;
      fab.classList.add('wa-rest');
    }

    function hidePeek(persist) {
      if (!peek) return;
      peek.classList.add('hidden');
      peek.classList.remove('flex');
      if (persist) {
        try { sessionStorage.setItem('waPeekHidden', 'true'); } catch (e) { /* noop */ }
      }
    }

    // --- Paso 1 -> Paso 2 ---
    function showStep1() {
      pendingIntent = null;
      if (subtopics) { subtopics.classList.add('hidden'); subtopics.classList.remove('flex'); subtopics.setAttribute('aria-hidden', 'true'); }
      if (quick) { quick.classList.remove('hidden'); quick.classList.add('flex'); }
    }
    function showStep2(intent) {
      pendingIntent = intent;
      if (quick) { quick.classList.add('hidden'); quick.classList.remove('flex'); }
      if (subtopics) {
        subtopics.classList.remove('hidden'); subtopics.classList.add('flex'); subtopics.setAttribute('aria-hidden', 'false');
        var firstTopic = subtopics.querySelector('[data-wa-topic]');
        if (firstTopic) firstTopic.focus();
      }
    }

    // Feedback "Abriendo WhatsApp…" antes de salir del sitio.
    function chipOpening(btn, text) {
      if (!btn) { openWhatsApp(text); return; }
      btn.classList.add('is-opening');
      var label = btn.querySelector('span span') ? btn.querySelector('span') : null;
      var go = function () { openWhatsApp(text); btn.classList.remove('is-opening'); };
      if (reduceMotion) { go(); } else { setTimeout(go, 450); }
    }

    function openChat() {
      isOpen = true;
      lastFocused = document.activeElement;
      stopPulse();
      hidePeek(true);
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      panel.setAttribute('aria-hidden', 'false');
      fab.setAttribute('aria-expanded', 'true');

      var reveal = function () {
        panel.classList.remove('scale-95', 'translate-y-5', 'opacity-0');
        panel.classList.add('scale-100', 'translate-y-0', 'opacity-100');
      };
      if (reduceMotion) { reveal(); } else { requestAnimationFrame(reveal); }

      // Mover el foco al botón de cerrar para accesibilidad
      if (closeBtn) closeBtn.focus();

      // Simular escritura -> mensaje + respuestas (una sola vez)
      if (!messageShown) {
        messageShown = true;
        var showMessage = function () {
          typingTimer = null;
          if (typing) typing.classList.add('hidden');
          if (message) message.classList.remove('hidden');
          showStep1();
        };
        if (reduceMotion) { showMessage(); } else { typingTimer = setTimeout(showMessage, 1500); }
      }
    }

    function closeChat(returnFocus) {
      isOpen = false;
      // Limpiar el typing si quedó pendiente (evita togglear clases sobre panel cerrado).
      if (typingTimer) { clearTimeout(typingTimer); typingTimer = null; }
      fab.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      panel.classList.remove('scale-100', 'translate-y-0', 'opacity-100');
      panel.classList.add('scale-95', 'translate-y-5', 'opacity-0');

      var finish = function () {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
      };
      if (reduceMotion) { finish(); } else { setTimeout(finish, 300); }

      // Devolver SIEMPRE el foco a un destino sensato (FAB por defecto).
      var target = returnFocus ? fab : (lastFocused && document.contains(lastFocused) && !panel.contains(lastFocused) ? lastFocused : fab);
      if (target && typeof target.focus === 'function') target.focus();
    }

    function toggleChat() { isOpen ? closeChat(true) : openChat(); }

    fab.addEventListener('click', toggleChat);
    if (closeBtn) closeBtn.addEventListener('click', function () { closeChat(true); });
    if (peek) peek.addEventListener('click', openChat);
    if (peekClose) peekClose.addEventListener('click', function (e) { e.stopPropagation(); hidePeek(true); });

    // Paso 1: elegir intención -> mostrar sub-opciones (mini-flujo)
    if (quick) {
      quick.querySelectorAll('[data-wa-intent]').forEach(function (btn) {
        btn.addEventListener('click', function () { showStep2(btn.getAttribute('data-wa-intent')); });
      });
    }
    // Paso 2: elegir área -> abrir WhatsApp con mensaje específico
    if (subtopics) {
      subtopics.querySelectorAll('[data-wa-topic]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          chipOpening(btn, buildMessage(pendingIntent || 'diagnostico', btn.getAttribute('data-wa-topic')));
        });
      });
    }
    if (backBtn) backBtn.addEventListener('click', showStep1);

    // CTA offline -> cerrar widget y desplazar al formulario de contacto
    var offlineLink = document.getElementById('wa-offline-link');
    if (offlineLink) {
      offlineLink.addEventListener('click', function () { closeChat(false); });
    }

    // --- Footer: input de texto libre ---
    function updateSendState() {
      if (!sendBtn || !input) return;
      sendBtn.disabled = input.value.trim().length === 0;
    }
    function syncPlaceholder() {
      if (!input) return;
      var ph = isEn() ? input.getAttribute('data-placeholder-en') : input.getAttribute('data-placeholder-es');
      if (ph) input.setAttribute('placeholder', ph);
    }
    syncPlaceholder();
    updateSendState();
    if (input) {
      input.addEventListener('input', updateSendState);
    }
    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!input) return;
        var txt = input.value.trim();
        if (!txt) { input.focus(); return; }
        var prefix = isEn() ? 'Hi KANTECH! ' : 'Hola KANTECH! ';
        openWhatsApp(prefix + txt);
        input.value = '';
        updateSendState();
      });
    }

    // Cerrar al hacer clic fuera
    document.addEventListener('click', function (e) {
      if (isOpen && !e.target.closest('#wa-widget')) closeChat(false);
    });

    // Teclado: ESC cierra; Tab atrapa el foco dentro del panel (focus-trap)
    document.addEventListener('keydown', function (e) {
      if (!isOpen) return;
      if (e.key === 'Escape') { closeChat(true); return; }
      if (e.key === 'Tab') {
        var focusables = panel.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), textarea, [tabindex]:not([tabindex="-1"])'
        );
        var visible = [];
        focusables.forEach(function (el) {
          if (el.offsetParent !== null || el === document.activeElement) visible.push(el);
        });
        if (!visible.length) return;
        var first = visible[0];
        var last = visible[visible.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      }
    });

    // Detener el pulso del FAB tras el primer scroll (reduce fatiga visual).
    window.addEventListener('scroll', stopPulse, { passive: true, once: true });

    // Re-sincronizar placeholder del input si cambia el idioma (observa el atributo del <html>).
    if (input && window.MutationObserver) {
      var langObserver = new MutationObserver(syncPlaceholder);
      langObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-active-lang'] });
    }

    // Mostrar peek bubble tras 2s (salvo que se haya descartado en la sesión)
    var peekHidden = false;
    try { peekHidden = sessionStorage.getItem('waPeekHidden') === 'true'; } catch (e) { /* noop */ }
    if (peek && !peekHidden) {
      setTimeout(function () {
        if (!isOpen && peek.classList.contains('hidden')) {
          peek.classList.remove('hidden');
          peek.classList.add('flex');
        }
      }, 2000);
    }
  })();
</script>
