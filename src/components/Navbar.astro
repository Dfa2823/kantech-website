---
const WA = 'https://wa.me/573194436045?text=Hola%2C%20me%20interesa%20conocer%20m%C3%A1s%20sobre%20los%20servicios%20de%20KANTECH';
const links = [
  { href: '#servicios',  es: 'Servicios',  en: 'Services' },
  { href: '#portafolio', es: 'Portafolio', en: 'Portfolio' },
  { href: '#modelos',    es: 'Precios',    en: 'Pricing' },
  { href: '#proceso',    es: 'Proceso',    en: 'Process' },
  { href: '#contacto',   es: 'Contacto',   en: 'Contact' },
];
---
<header id="navbar" class="fixed top-0 w-full z-50 bg-transparent transition-all duration-300">
  <!-- Barra de progreso de scroll -->
  <div id="scroll-progress" class="absolute top-0 left-0 w-full h-[2px] opacity-0 transition-opacity duration-300 z-50"></div>
  <!-- Hairline de gradiente (estado scroll) -->
  <div id="nav-border" class="absolute bottom-0 left-0 w-full h-px opacity-0 transition-opacity duration-300 z-0 bg-gradient-to-r from-primary via-accent to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center relative z-10">
    <!-- Logo oficial -->
    <a href="/" class="flex items-center group" aria-label="kantech SOLUTIONS — inicio">
      <img src="/brand/logo-horizontal-dark.png" alt="kantech SOLUTIONS" width="412" height="83"
           class="h-9 w-auto transition-transform duration-300 group-hover:scale-[1.03]" />
    </a>

    <!-- Links desktop -->
    <nav class="hidden md:flex items-center gap-8 relative" aria-label="Navegación principal">
      {links.map(l => (
        <a href={l.href} class="nav-link text-muted hover:text-text font-medium text-sm transition-colors relative py-2">
          <span data-lang="es">{l.es}</span><span data-lang="en">{l.en}</span>
          <span class="nav-underline absolute bottom-0 left-0 w-full h-[2px] bg-primary rounded-full transform scale-x-0 transition-transform duration-300 origin-left"></span>
        </a>
      ))}
    </nav>

    <!-- Acciones + idioma (desktop) -->
    <div class="hidden md:flex items-center gap-6">
      <!-- Switch ES|EN segmentado -->
      <div class="relative flex items-center bg-surface-1 rounded-full p-1 border border-border shadow-inner" id="lang-switch" role="group" aria-label="Seleccionar idioma / Select language">
        <div class="lang-indicator absolute left-1 top-1 bottom-1 w-8 bg-surface-3 rounded-full shadow-sm border border-white/5"></div>
        <button onclick="setLang('es')" data-lang-btn="es" class="lang-opt relative z-10 w-8 text-xs font-semibold py-1 transition-colors" aria-label="Español" aria-pressed="true">ES</button>
        <button onclick="setLang('en')" data-lang-btn="en" class="lang-opt relative z-10 w-8 text-xs font-semibold py-1 transition-colors" aria-label="English" aria-pressed="false">EN</button>
      </div>

      <!-- CTA magnético -->
      <div class="flex flex-col items-end group">
        <a id="nav-cta" href={WA} target="_blank" rel="noopener"
           class="relative inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-[#07101F] px-5 py-2.5 rounded-full font-medium text-sm transition-all duration-300 transform group-hover:-translate-y-0.5 shadow-[0_0_20px_rgba(106,195,198,0.3)] hover:shadow-[0_0_30px_rgba(106,195,198,0.5)] overflow-hidden">
          <span class="absolute inset-0 rounded-full border border-white/20 pointer-events-none"></span>
          <span class="nav-cta-inner inline-flex items-center gap-2">
            <span class="material-symbols-outlined text-lg" style="font-variation-settings:'FILL' 1;" aria-hidden="true">chat</span>
            <span data-lang="es">Hablar con experto</span><span data-lang="en">Talk to an expert</span>
          </span>
        </a>
        <!-- Cupos / escasez honesta (cae a "respondemos en minutos" si no quedan o si JS falla) -->
        <div class="flex items-center gap-1.5 mt-1.5 opacity-80 group-hover:opacity-100 transition-opacity" aria-live="polite">
          <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse shadow-[0_0_8px_rgba(47,215,159,0.8)]"></span>
          <span class="text-[10px] text-muted tracking-wide uppercase" data-slots-text>
            <span data-lang="es">respondemos en minutos</span><span data-lang="en">we reply in minutes</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Botón menú móvil -->
    <button id="menu-btn" class="md:hidden text-text p-2 -mr-2" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-icon-wrap relative inline-block w-7 h-7" aria-hidden="true">
        <span class="material-symbols-outlined text-2xl menu-icon-open absolute inset-0 flex items-center justify-center">menu</span>
        <span class="material-symbols-outlined text-2xl menu-icon-close absolute inset-0 flex items-center justify-center">close</span>
      </span>
    </button>
  </div>
</header>

<!-- Scrim móvil -->
<div id="mobile-overlay" class="fixed inset-0 bg-surface-0/80 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>

<!-- Drawer móvil -->
<div id="mobile-menu" class="fixed top-0 right-0 w-4/5 max-w-sm h-full bg-surface-1 border-l border-border z-50 shadow-2xl shadow-black flex flex-col translate-x-full transition-transform duration-300 md:hidden" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div class="flex justify-between items-center p-6 border-b border-border">
    <img src="/brand/logo-horizontal-dark.png" alt="kantech SOLUTIONS" width="412" height="83" class="h-8 w-auto" />
    <button id="menu-close" class="text-muted hover:text-text p-1" aria-label="Cerrar menú">
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">close</span>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-8">
    <nav class="flex flex-col gap-6" aria-label="Navegación móvil">
      {links.map(l => (
        <a href={l.href} data-mobile-link class="mobile-link relative text-muted hover:text-text font-display font-medium text-lg transition-colors">
          <span data-lang="es">{l.es}</span><span data-lang="en">{l.en}</span>
        </a>
      ))}
    </nav>
    <div class="mt-auto pt-6 border-t border-border flex flex-col gap-6">
      <div class="flex justify-center">
        <div class="relative flex items-center bg-surface-2 rounded-full p-1 border border-border shadow-inner w-full max-w-[200px]" role="group" aria-label="Seleccionar idioma / Select language">
          <div class="lang-indicator absolute left-1 top-1 bottom-1 w-[calc(50%-4px)] bg-surface-3 rounded-full shadow-sm border border-white/5"></div>
          <button onclick="setLang('es')" data-lang-btn="es" class="lang-opt relative z-10 flex-1 text-sm font-semibold py-2 transition-colors" aria-pressed="true">ES</button>
          <button onclick="setLang('en')" data-lang-btn="en" class="lang-opt relative z-10 flex-1 text-sm font-semibold py-2 transition-colors" aria-pressed="false">EN</button>
        </div>
      </div>
      <div class="flex flex-col items-center gap-3">
        <a href={WA} target="_blank" rel="noopener"
           class="w-full flex justify-center items-center gap-2 bg-primary hover:bg-primary-hover text-[#07101F] px-6 py-4 rounded-xl font-medium text-sm transition-all shadow-[0_0_20px_rgba(106,195,198,0.2)]">
          <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1;" aria-hidden="true">chat</span>
          <span data-lang="es">Hablar con experto</span><span data-lang="en">Talk to an expert</span>
        </a>
        <div class="flex items-center gap-2" aria-live="polite">
          <span class="w-2 h-2 rounded-full bg-success animate-pulse shadow-[0_0_8px_rgba(47,215,159,0.8)]"></span>
          <span class="text-xs text-muted" data-slots-text>
            <span data-lang="es">Diagnóstico gratis · &lt;24h</span><span data-lang="en">Free diagnosis · &lt;24h</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Navbar: estado scroll glass */
  #navbar.glass-nav {
    background: rgba(14,26,51, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #scroll-progress {
    background: linear-gradient(90deg, #6AC3C6, #6AC3C6);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.1s linear;
  }
  /* Indicador del switch sigue el estado global de idioma (única fuente de verdad) */
  .lang-indicator { transition: transform 0.3s cubic-bezier(0.4,0,0.2,1); transform: translateX(0); }
  html[data-active-lang="en"] .lang-indicator { transform: translateX(100%); }
  .lang-opt { color: #A9B6CC; }
  html:not([data-active-lang="en"]) .lang-opt[data-lang-btn="es"],
  html[data-active-lang="en"] .lang-opt[data-lang-btn="en"] { color: #F4F6FF; font-weight: 700; }
  /* Link activo (scrollspy) */
  .nav-link.is-active { color: #F4F6FF; }
  .nav-link.is-active .nav-underline { transform: scaleX(1); }
  .nav-link:hover .nav-underline { transform: scaleX(1); }

  /* CTA magnético: el contenido sigue al cursor (gateado por JS + reduced-motion) */
  .nav-cta-inner { transition: transform 0.25s cubic-bezier(0.22,1,0.36,1); will-change: transform; }
  #nav-cta:focus-visible { outline: 2px solid #6AC3C6; outline-offset: 3px; }

  /* Foco visible coherente para controles del navbar */
  .lang-opt:focus-visible,
  #menu-btn:focus-visible,
  #menu-close:focus-visible,
  .nav-link:focus-visible,
  .mobile-link:focus-visible { outline: 2px solid #6AC3C6; outline-offset: 2px; border-radius: 6px; }

  /* Morfología del icono menú ↔ cerrar */
  .menu-icon-open, .menu-icon-close {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .menu-icon-close { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  .menu-icon-open  { opacity: 1; transform: rotate(0deg) scale(1); }
  #menu-btn[aria-expanded="true"] .menu-icon-open  { opacity: 0; transform: rotate(90deg) scale(0.6); }
  #menu-btn[aria-expanded="true"] .menu-icon-close { opacity: 1; transform: rotate(0deg) scale(1); }

  /* Scrollspy en el drawer móvil (mismo lenguaje que .nav-link) */
  .mobile-link.is-active { color: #F4F6FF; padding-left: 1rem; }
  .mobile-link::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 0; height: 2px;
    background: #6AC3C6;
    border-radius: 9999px;
    transform: translateY(-50%);
    transition: width 0.3s cubic-bezier(0.4,0,0.2,1);
  }
  .mobile-link.is-active::before { width: 0.625rem; }

  @media (prefers-reduced-motion: reduce) {
    .nav-cta-inner,
    .menu-icon-open, .menu-icon-close,
    .mobile-link, .mobile-link::before { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const navbar = document.getElementById('navbar');
    const progress = document.getElementById('scroll-progress');
    const navBorder = document.getElementById('nav-border');
    let ticking = false;
    function onScroll() {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max > 0 && progress) progress.style.transform = `scaleX(${y / max})`;
      if (y > 40) {
        navbar && navbar.classList.add('glass-nav');
        progress && (progress.style.opacity = '1');
        navBorder && (navBorder.style.opacity = '1');
      } else {
        navbar && navbar.classList.remove('glass-nav');
        progress && (progress.style.opacity = '0');
        navBorder && (navBorder.style.opacity = '0');
      }
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });

    // ── Cupos / escasez honesta ───────────────────────────────────────
    // 5 diagnósticos por semana ISO, menos 1 por cada día transcurrido (lun=1…).
    // Se persiste por semana ISO en localStorage: una vez fijado el "consumo"
    // base de la semana, no sube ni baja erráticamente entre recargas.
    (function initSlots() {
      const labels = document.querySelectorAll('[data-slots-text]');
      if (!labels.length) return;

      function isoWeekKey(d) {
        const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        const day = date.getUTCDay() || 7;            // lun=1 … dom=7
        date.setUTCDate(date.getUTCDate() + 4 - day); // jueves de esta semana
        const yearStart = new Date(Date.UTC(date.getUTCFullYear(), 0, 1));
        const week = Math.ceil((((date - yearStart) / 86400000) + 1) / 7);
        return date.getUTCFullYear() + '-W' + week;
      }

      const now = new Date();
      const dow = now.getDay() || 7;                  // lun=1 … dom=7
      const TOTAL = 5;
      // Consumo crece con la semana; al menos 1 consumido el lunes.
      let remaining = Math.max(0, TOTAL - dow);

      const weekKey = isoWeekKey(now);
      try {
        const stored = JSON.parse(localStorage.getItem('kantech-slots') || 'null');
        if (stored && stored.week === weekKey && typeof stored.remaining === 'number') {
          remaining = stored.remaining;
        } else {
          localStorage.setItem('kantech-slots', JSON.stringify({ week: weekKey, remaining }));
        }
      } catch (e) { /* sin persistencia: usamos el cálculo del día */ }

      // Solo pintamos el gancho de escasez si quedan 1-3 cupos (honesto y urgente).
      if (remaining < 1 || remaining > 3) return;

      labels.forEach(label => {
        const es = label.querySelector('[data-lang="es"]');
        const en = label.querySelector('[data-lang="en"]');
        const plural = remaining === 1;
        if (es) es.textContent = plural
          ? 'Queda 1 diagnóstico gratis esta semana'
          : 'Quedan ' + remaining + ' diagnósticos gratis esta semana';
        if (en) en.textContent = plural
          ? '1 free diagnosis left this week'
          : remaining + ' free diagnoses left this week';
      });
    })();

    // ── CTA magnético (desktop, con puntero fino y sin reduced-motion) ──
    (function magneticCTA() {
      if (reduceMotion) return;
      const fine = window.matchMedia && window.matchMedia('(pointer: fine)').matches;
      if (!fine) return;
      const cta = document.getElementById('nav-cta');
      const inner = cta && cta.querySelector('.nav-cta-inner');
      if (!cta || !inner) return;
      const STRENGTH = 6; // px máx de desplazamiento
      cta.addEventListener('mousemove', e => {
        const r = cta.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        inner.style.transform = `translate(${dx * STRENGTH}px, ${dy * STRENGTH}px)`;
      });
      cta.addEventListener('mouseleave', () => { inner.style.transform = 'translate(0,0)'; });
    })();

    // ── Menú móvil + focus trap ────────────────────────────────────────
    const btn = document.getElementById('menu-btn');
    const closeBtn = document.getElementById('menu-close');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    let lastFocused = null;

    function focusables() {
      if (!menu) return [];
      return Array.from(menu.querySelectorAll(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )).filter(el => el.offsetParent !== null);
    }

    function open() {
      if (!menu || !overlay) return;
      lastFocused = document.activeElement;
      menu.classList.remove('translate-x-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
      btn && btn.setAttribute('aria-expanded', 'true');
      // Mover foco al botón de cerrar tras la transición.
      const focusTarget = closeBtn || focusables()[0];
      if (focusTarget) {
        if (reduceMotion) focusTarget.focus();
        else window.setTimeout(() => focusTarget.focus(), 60);
      }
    }
    function shut() {
      if (!menu || !overlay) return;
      menu.classList.add('translate-x-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      btn && btn.setAttribute('aria-expanded', 'false');
      // Devolver el foco al disparador.
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      else btn && btn.focus();
    }
    function isOpen() {
      return menu && !menu.classList.contains('translate-x-full');
    }

    btn && btn.addEventListener('click', open);
    closeBtn && closeBtn.addEventListener('click', shut);
    overlay && overlay.addEventListener('click', shut);
    document.querySelectorAll('[data-mobile-link]').forEach(a => a.addEventListener('click', shut));

    document.addEventListener('keydown', e => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { shut(); return; }
      if (e.key === 'Tab') {
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      }
    });

    // ── Switch ES|EN: única fuente de verdad ──────────────────────────
    // El color activo lo controla el CSS html[data-active-lang] .lang-opt.
    // Aquí solo sincronizamos aria-pressed con el idioma activo (a11y),
    // observando el atributo que setLang() de Layout actualiza.
    (function syncLangAria() {
      const langBtns = document.querySelectorAll('.lang-opt[data-lang-btn]');
      if (!langBtns.length) return;
      function apply() {
        const active = document.documentElement.getAttribute('data-active-lang') || 'es';
        langBtns.forEach(b => {
          b.setAttribute('aria-pressed', String(b.dataset.langBtn === active));
        });
      }
      apply();
      const mo = new MutationObserver(apply);
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-active-lang'] });
    })();

    // ── Scrollspy en el drawer móvil (espeja el global de .nav-link) ───
    (function mobileScrollspy() {
      const mobileLinks = document.querySelectorAll('[data-mobile-link]');
      if (!mobileLinks.length) return;
      const sections = document.querySelectorAll('section[id]');
      if (!sections.length) return;
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            mobileLinks.forEach(link => {
              link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
            });
          }
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      sections.forEach(s => io.observe(s));
    })();
  })();
</script>
