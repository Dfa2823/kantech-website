---
// Carrusel de tecnologías (marquee infinito interactivo)
// Cada tech lleva una frase de valor bilingüe (tooltip/popover) y, las clave,
// un deep-link a WhatsApp prellenado por integración o un ancla a #servicios.
const WA = 'https://wa.me/573194436045';
const techs = [
  { f: 'n8n',        n: 'n8n',        es: 'Automatizamos tus flujos sin código y conectamos todas tus apps.', en: 'We automate your no-code workflows and connect all your apps.', href: `${WA}?text=${encodeURIComponent('Hola KANTECH! Quiero automatizar mis flujos con n8n.')}` },
  { f: 'make',       n: 'Make',       es: 'Orquestamos integraciones visuales entre tus herramientas.',        en: 'We orchestrate visual integrations across your tools.' },
  { f: 'openai',     n: 'OpenAI',     es: 'Construimos agentes de IA con los modelos GPT más avanzados.',      en: 'We build AI agents with the most advanced GPT models.',       href: `${WA}?text=${encodeURIComponent('Hola KANTECH! Quiero un agente de IA para mi negocio.')}` },
  { f: 'claude',     n: 'Claude',     es: 'Agentes de IA precisos y seguros con Claude de Anthropic.',          en: 'Precise, safe AI agents powered by Anthropic’s Claude.' },
  { f: 'gemini',     n: 'Gemini',     es: 'IA multimodal de Google integrada a tu operación.',                 en: 'Google’s multimodal AI integrated into your operation.' },
  { f: 'whatsapp',   n: 'WhatsApp',   es: 'Atención y ventas 24/7 con agentes de IA en WhatsApp Business.',    en: '24/7 support and sales with AI agents on WhatsApp Business.',  href: `${WA}?text=${encodeURIComponent('Hola KANTECH! Quiero un agente de IA en WhatsApp para mi negocio.')}` },
  { f: 'odoo',       n: 'Odoo',       es: 'Implementamos e integramos tu ERP Odoo a medida.',                  en: 'We implement and integrate your custom Odoo ERP.',            href: `${WA}?text=${encodeURIComponent('Hola KANTECH! Quiero integrar mi negocio con Odoo.')}` },
  { f: 'siigo',      n: 'Siigo',      es: 'Conectamos Siigo con tus procesos y eliminamos el doble registro.', en: 'We connect Siigo to your processes and kill double data entry.', href: `${WA}?text=${encodeURIComponent('Hola KANTECH! Quiero integrar Siigo con mis procesos.')}` },
  { f: 'google',     n: 'Google',     es: 'Automatizamos Google Workspace: Sheets, Gmail, Drive y más.',        en: 'We automate Google Workspace: Sheets, Gmail, Drive and more.' },
  { f: 'python',     n: 'Python',     es: 'Desarrollamos backends y scripts robustos a medida.',               en: 'We build robust custom backends and scripts.' },
  { f: 'react',      n: 'React',      es: 'Interfaces web rápidas y modernas para tu producto.',               en: 'Fast, modern web interfaces for your product.' },
  { f: 'astro',      n: 'Astro',      es: 'Sitios ultrarrápidos y optimizados para conversión.',               en: 'Ultra-fast sites optimized for conversion.' },
  { f: 'nodejs',     n: 'Node.js',    es: 'APIs y servicios en tiempo real para escalar tu sistema.',          en: 'Real-time APIs and services to scale your system.' },
  { f: 'postgresql', n: 'PostgreSQL', es: 'Bases de datos sólidas y seguras para tu información crítica.',      en: 'Solid, secure databases for your critical data.' },
  { f: 'docker',     n: 'Docker',     es: 'Despliegues confiables y reproducibles de tus sistemas.',           en: 'Reliable, reproducible deployments of your systems.' },
];
const loop = [...techs, ...techs]; // dos copias para loop continuo
---
<section id="tecnologias" class="relative py-20 md:py-24 border-t border-border/40 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6 text-center mb-14">
    <span class="section-label animate-fade-up" data-animate>
      <span data-lang="es">Tecnologías</span><span data-lang="en">Technologies</span>
    </span>
    <h2 class="section-title mt-5 animate-fade-up delay-100" data-animate>
      <span data-lang="es">El stack que impulsa <span class="gradient-text">tu operación.</span></span>
      <span data-lang="en">The stack that powers <span class="gradient-text">your operation.</span></span>
    </h2>
    <p class="section-sub mx-auto mt-4 animate-fade-up delay-200" data-animate>
      <span data-lang="es">Integramos y construimos con las herramientas líderes en automatización, IA y desarrollo — las mismas en las que ya confías o vas a necesitar.</span>
      <span data-lang="en">We integrate and build with the leading tools in automation, AI and development — the same ones you already trust or will need.</span>
    </p>
    <p class="mt-4 text-sm text-muted/80 animate-fade-up delay-300" data-animate>
      <span data-lang="es">Pasa el cursor o toca un logo para ver cómo lo usamos.</span>
      <span data-lang="en">Hover or tap a logo to see how we use it.</span>
    </p>
  </div>

  <div class="tech-marquee-wrap animate-fade-up delay-300" data-animate data-tech-wrap>
    <ul
      class="tech-marquee-track"
      data-tech-track
      role="list"
      aria-label="Tecnologías que usamos"
    >
      {loop.map((t, i) => {
        const isClone = i >= techs.length;
        const interactive = !isClone;
        const Tag = t.href ? 'a' : 'button';
        return (
          <li class="tech-item" role="listitem" aria-hidden={isClone ? 'true' : undefined}>
            <Tag
              class:list={['tech-trigger', t.href && 'is-link', t.href && 'is-key']}
              {...(t.href
                ? { href: t.href, target: '_blank', rel: 'noopener' }
                : { type: 'button' })}
              tabindex={interactive ? '0' : '-1'}
              aria-hidden={isClone ? 'true' : undefined}
              data-tech-trigger={interactive ? '' : undefined}
              data-tech-name={t.n}
              aria-label={t.n}
              aria-describedby={interactive ? `tech-tip-${t.f}` : undefined}
            >
              <img
                src={`/tech/${t.f}.svg`}
                alt={t.n}
                width="48"
                height="48"
                loading={i < 8 ? 'eager' : 'lazy'}
                decoding="async"
                class="tech-logo"
              />
              <span class="tech-name">{t.n}</span>
              {t.href && (
                <span class="tech-cta" aria-hidden="true">
                  <span class="material-symbols-outlined">open_in_new</span>
                </span>
              )}
            </Tag>
            {interactive && (
              <span class="tech-tip" id={`tech-tip-${t.f}`} role="tooltip">
                <span class="tech-tip-text">
                  <span data-lang="es">{t.es}</span><span data-lang="en">{t.en}</span>
                </span>
                {t.href && (
                  <span class="tech-tip-cta">
                    <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                    <span data-lang="es">Hablar de esta integración</span><span data-lang="en">Talk about this integration</span>
                  </span>
                )}
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <!-- Control de movimiento (WCAG 2.2.2) -->
  <div class="mt-8 flex justify-center animate-fade-up delay-400" data-animate>
    <button
      type="button"
      class="tech-pause-btn"
      data-tech-pause
      aria-pressed="false"
    >
      <span class="material-symbols-outlined tech-pause-icon" aria-hidden="true">pause</span>
      <span class="tech-pause-label">
        <span data-pause-state="running">
          <span data-lang="es">Pausar animación</span><span data-lang="en">Pause animation</span>
        </span>
        <span data-pause-state="paused" hidden>
          <span data-lang="es">Reanudar animación</span><span data-lang="en">Resume animation</span>
        </span>
      </span>
    </button>
  </div>
</section>

<style is:global>
  .tech-marquee-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    cursor: grab;
  }
  .tech-marquee-wrap.is-dragging { cursor: grabbing; }
  .tech-marquee-track {
    display: flex;
    align-items: flex-start;
    gap: 3.5rem;
    width: max-content;
    margin: 0;
    padding: 0.5rem 1.75rem;
    list-style: none;
    animation: tech-scroll 48s linear infinite;
  }
  /* Pausa por hover, foco de teclado y control manual */
  .tech-marquee-wrap:hover .tech-marquee-track,
  .tech-marquee-wrap:focus-within .tech-marquee-track,
  .tech-marquee-wrap.is-paused .tech-marquee-track,
  .tech-marquee-wrap.is-dragging .tech-marquee-track { animation-play-state: paused; }
  @keyframes tech-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .tech-item {
    position: relative;
    display: flex;
    justify-content: center;
    min-width: 96px;
    flex-shrink: 0;
  }
  /* El trigger reemplaza al antiguo .tech-item como bloque clicable */
  .tech-trigger {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.4rem 0.4rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    cursor: pointer;
    color: inherit;
    font: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .tech-trigger:hover,
  .tech-trigger:focus-visible {
    background: rgba(106, 195, 198, 0.06);
    border-color: rgba(106, 195, 198, 0.25);
  }
  .tech-trigger:active { transform: scale(0.97); }

  .tech-logo {
    height: 2.5rem;
    width: 2.75rem;
    object-fit: contain;
    /* Duotono navy/teal en reposo para que se lean como marcas reales (no placeholders) */
    filter: grayscale(1) brightness(1.15) sepia(0.35) hue-rotate(135deg) saturate(0.7);
    opacity: 0.78;
    transition: filter 0.35s ease, opacity 0.35s ease, transform 0.35s ease;
  }
  .tech-trigger:hover .tech-logo,
  .tech-trigger:focus-visible .tech-logo {
    filter: none;
    opacity: 1;
    transform: translateY(-4px) scale(1.08);
  }
  .tech-name {
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #A4B6CC;
    opacity: 0.7;
    transition: opacity 0.35s ease, color 0.35s ease;
  }
  .tech-trigger:hover .tech-name,
  .tech-trigger:focus-visible .tech-name { opacity: 1; color: #EEF3FA; }

  /* Indicador de enlace (solo techs clave) — teal = acción */
  .tech-cta {
    position: absolute;
    top: 0.15rem;
    right: 0.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: rgba(106, 195, 198, 0.14);
    color: #6AC3C6;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .tech-cta .material-symbols-outlined { font-size: 12px; }
  .tech-trigger.is-key:hover .tech-cta,
  .tech-trigger.is-key:focus-visible .tech-cta { opacity: 1; transform: scale(1); }

  /* Tooltip / popover de valor */
  .tech-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.6rem);
    transform: translate(-50%, 6px);
    width: max-content;
    max-width: 16rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.7rem;
    background: #0E1A33;
    border: 1px solid rgba(106, 195, 198, 0.25);
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.6), inset 0 1px 0 0 rgba(255,255,255,0.05);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 20;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }
  .tech-tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: #0E1A33;
  }
  .tech-tip-text {
    display: block;
    font-size: 0.78rem;
    line-height: 1.4;
    color: #EEF3FA;
  }
  .tech-tip-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.5rem;
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6AC3C6;
  }
  .tech-tip-cta .material-symbols-outlined { font-size: 14px; }
  /* Mostrar tooltip al hover/focus del trigger, o cuando JS lo marca abierto (touch) */
  .tech-trigger:hover + .tech-tip,
  .tech-trigger:focus-visible + .tech-tip,
  .tech-item.is-open .tech-tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  /* Botón de pausa */
  .tech-pause-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--surface-1, #0E1A33);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #A4B6CC;
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .tech-pause-btn:hover { color: #EEF3FA; border-color: rgba(106, 195, 198, 0.35); }
  .tech-pause-icon { font-size: 16px; }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee-wrap { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .tech-marquee-track { animation: none; }
    .tech-logo { transition: none; }
    .tech-tip { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const wrap = document.querySelector('[data-tech-wrap]');
    const track = document.querySelector('[data-tech-track]');
    const pauseBtn = document.querySelector('[data-tech-pause]');
    if (!wrap || !track) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* ---------- Botón pausar / reanudar (WCAG 2.2.2) ---------- */
    if (pauseBtn) {
      const icon = pauseBtn.querySelector('.tech-pause-icon');
      const stateRunning = pauseBtn.querySelector('[data-pause-state="running"]');
      const statePaused = pauseBtn.querySelector('[data-pause-state="paused"]');
      const setPaused = (paused) => {
        wrap.classList.toggle('is-paused', paused);
        pauseBtn.setAttribute('aria-pressed', String(paused));
        if (icon) icon.textContent = paused ? 'play_arrow' : 'pause';
        if (stateRunning) stateRunning.hidden = paused;
        if (statePaused) statePaused.hidden = !paused;
      };
      pauseBtn.addEventListener('click', () => {
        setPaused(!wrap.classList.contains('is-paused'));
      });
      // Si el usuario prefiere menos movimiento, el botón refleja el estado inicial pausado.
      if (reduceMotion.matches) setPaused(true);
    }

    /* ---------- Tooltip táctil: abrir/cerrar en touch sin perder el deep-link ---------- */
    // En desktop el tooltip es puro CSS (hover/focus). En touch (sin hover real),
    // el primer tap muestra el tooltip y el segundo sigue el enlace.
    const canHover = window.matchMedia('(hover: hover)');
    if (!canHover.matches) {
      const closeAll = (except) => {
        track.querySelectorAll('.tech-item.is-open').forEach((item) => {
          if (item !== except) item.classList.remove('is-open');
        });
      };
      track.querySelectorAll('[data-tech-trigger]').forEach((trigger) => {
        const item = trigger.closest('.tech-item');
        if (!item) return;
        trigger.addEventListener('click', (e) => {
          // Si el tooltip aún no está visible, primer tap = mostrar info, no navegar.
          if (!item.classList.contains('is-open')) {
            e.preventDefault();
            closeAll(item);
            item.classList.add('is-open');
          }
          // Segundo tap sobre el mismo trigger (ya abierto): el enlace/botón actúa normal.
        });
      });
      // Tocar fuera cierra cualquier tooltip abierto.
      document.addEventListener('click', (e) => {
        if (!track.contains(e.target)) closeAll(null);
      });
    }

    /* ---------- Drag-to-scroll (pointer events) ---------- */
    // Solo si el contenedor puede desplazarse horizontalmente (reduced-motion lo vuelve scrollable).
    let isDown = false;
    let moved = false;
    let startX = 0;
    let startScroll = 0;

    const isScrollable = () => wrap.scrollWidth > wrap.clientWidth + 4;

    wrap.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      if (reduceMotion.matches && !isScrollable()) return;
      isDown = true;
      moved = false;
      startX = e.clientX;
      startScroll = wrap.scrollLeft;
      wrap.classList.add('is-dragging');
    });

    wrap.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      // Cuando hay scroll real (reduced-motion / overflow-x auto) movemos el scroll nativo.
      if (isScrollable()) {
        wrap.scrollLeft = startScroll - dx;
      }
    });

    const endDrag = (e) => {
      if (!isDown) return;
      isDown = false;
      wrap.classList.remove('is-dragging');
      // Evita que un drag dispare el clic del enlace subyacente.
      if (moved && e && e.target) {
        const trigger = e.target.closest && e.target.closest('.tech-trigger');
        if (trigger) {
          const block = (ev) => { ev.preventDefault(); ev.stopPropagation(); };
          trigger.addEventListener('click', block, { capture: true, once: true });
          setTimeout(() => trigger.removeEventListener('click', block, { capture: true }), 0);
        }
      }
    };
    wrap.addEventListener('pointerup', endDrag);
    wrap.addEventListener('pointercancel', endDrag);
    wrap.addEventListener('pointerleave', endDrag);
  })();
</script>
