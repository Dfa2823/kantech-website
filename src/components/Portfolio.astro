---
// Portfolio — Casos de éxito reales (bento grid premium).
// ES copy proviene del diseño Stitch; EN del componente previo (traducido fiel donde no existía).
// Emerald (text-success) reservado estrictamente para métricas/ROI/prueba.
const WA_PROYECTO = 'https://wa.me/573194436045?text=Hola%2C%20quiero%20hablar%20sobre%20un%20proyecto';

const filters = [
  { key: 'todos',      es: 'Todos',            en: 'All' },
  { key: 'salud',      es: 'Salud & Estética', en: 'Health & Aesthetics' },
  { key: 'contabilidad', es: 'Contabilidad',   en: 'Accounting' },
  { key: 'manufactura',  es: 'Manufactura',    en: 'Manufacturing' },
  { key: 'automatizacion', es: 'Automatización', en: 'Automation' },
];
---
<section id="portafolio" class="relative overflow-hidden py-24 px-6 md:px-8">
  <!-- Aurora sutil de fondo (radial, sin canvas) -->
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true"
       style="background: radial-gradient(circle at 20% 30%, rgba(106,195,198,0.06) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(106,195,198,0.06) 0%, transparent 50%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full">

    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-up" data-animate>
      <span class="inline-block uppercase tracking-widest text-xs font-semibold bg-primary/10 text-accent border border-primary/20 px-3 py-1 rounded-full mb-6 font-display">
        <span data-lang="es">Portafolio</span>
        <span data-lang="en">Portfolio</span>
      </span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-text">
        <span data-lang="es">Casos de éxito <span class="gradient-text">reales.</span></span>
        <span data-lang="en">Real success <span class="gradient-text">stories.</span></span>
      </h2>
      <p class="text-lg text-muted leading-relaxed">
        <span data-lang="es">Estas empresas tenían el mismo problema que tú: procesos lentos, datos dispersos y equipos ahogados en tareas manuales.</span>
        <span data-lang="en">These companies had the same problem as you: slow processes, scattered data, and teams drowning in manual tasks.</span>
      </p>
    </div>

    <!-- Chips de filtro -->
    <div id="portfolio-filters" class="flex flex-wrap justify-center gap-3 mb-16 animate-fade-up delay-100" data-animate role="group" aria-label="Filtrar casos por sector">
      {filters.map((f, i) => (
        <button
          type="button"
          class={`filter-chip px-4 py-2 rounded-full border border-border bg-surface-1 text-sm font-medium transition-all ${i === 0 ? 'active text-text' : 'text-muted hover:text-text hover:border-border/80'}`}
          data-filter={f.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? '0' : '-1'}
        >
          <span data-lang="es">{f.es}</span>
          <span data-lang="en">{f.en}</span>
        </button>
      ))}
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Card flagship SOFY (ancha) -->
      <article
        class="portfolio-card card-glow glass-panel rounded-xl p-6 lg:col-span-2 group flex flex-col md:flex-row gap-6 relative overflow-hidden animate-fade-up delay-100"
        data-animate data-category="manufactura" data-tilt
        data-project="SOFY — ERP Industrial a Medida" data-project-en="SOFY — Custom Industrial ERP"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="md:w-1/2 flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Producción / Manufactura</span>
                <span data-lang="en">Production / Manufacturing</span>
              </span>
            </div>
            <h3 class="font-display text-2xl font-bold text-text mb-2">
              <span data-lang="es">SOFY — ERP Industrial a Medida</span>
              <span data-lang="en">SOFY — Custom Industrial ERP</span>
            </h3>
            <p class="text-muted text-sm mb-6">
              <span data-lang="es">Plataforma integral para gestión de planta, inventario en tiempo real y flujos de trabajo de manufactura.</span>
              <span data-lang="en">All-in-one platform for plant management, real-time inventory, and manufacturing workflows.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="flex items-center gap-2 mb-4">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">check_circle</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">Control total de producción</span>
                <span data-lang="en">Full production control</span>
              </span>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">
                <span class="material-symbols-outlined text-[14px] mr-1" aria-hidden="true">commit</span> 258 commits
              </span>
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">
                <span class="material-symbols-outlined text-[14px] mr-1" aria-hidden="true">rocket_launch</span> 264 deploys
              </span>
            </div>
          </div>
        </div>
        <div class="md:w-1/2 rounded-lg overflow-hidden border border-border relative min-h-[14rem]">
          <img
            src="/img/05_portfolio-0.png"
            loading="lazy" decoding="async"
            alt="Dashboard del ERP industrial SOFY: métricas de planta, gráficos y diagramas de flujo de manufactura en tema oscuro."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-0/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="case-overlay">
            <a class="case-cta" href="#" data-wa-case rel="noopener" target="_blank">
              <span data-lang="es">Ver caso</span><span data-lang="en">See case</span>
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Card 2: CRM Comercial -->
      <article
        class="portfolio-card card-glow glass-panel rounded-xl p-6 flex flex-col group relative overflow-hidden animate-fade-up delay-200"
        data-animate data-category="salud" data-tilt
        data-project="CRM Comercial Integral (Sanavit)" data-project-en="Full Commercial CRM (Sanavit)"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="rounded-lg overflow-hidden border border-border mb-5 relative h-48">
          <img
            src="/img/05_portfolio-1.png"
            loading="lazy" decoding="async"
            alt="Interfaz de CRM para salud y estética: agenda de citas, pipeline de pacientes y actividad reciente en UI oscura."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
          <div class="case-overlay">
            <a class="case-cta" href="#" data-wa-case rel="noopener" target="_blank">
              <span data-lang="es">Ver caso</span><span data-lang="en">See case</span>
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
        <div class="flex-grow flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Salud & Estética</span>
                <span data-lang="en">Health & Aesthetics</span>
              </span>
            </div>
            <h3 class="font-display text-xl font-bold text-text mb-2">
              <span data-lang="es">CRM Comercial Integral</span>
              <span data-lang="en">Full Commercial CRM</span>
            </h3>
            <p class="text-muted text-sm mb-4">
              <span data-lang="es">Pipeline 100% visible. Gestión de citas y seguimiento de leads automatizado.</span>
              <span data-lang="en">Pipeline 100% visible. Automated appointment management and lead tracking.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="inline-flex items-center gap-2 mb-4 bg-success/10 px-3 py-1.5 rounded-md border border-success/20">
              <span class="material-symbols-outlined text-success text-sm" aria-hidden="true">trending_down</span>
              <span class="font-display font-bold text-success text-sm">
                <span data-lang="es">~15 h/semana ahorradas</span>
                <span data-lang="en">~15 h/week saved</span>
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <div class="flex items-center gap-1.5">
                <a href="https://github.com/Dfa2823/crm-sanavit" target="_blank" rel="noopener"
                   class="repo-link group/repo inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-1 border border-border text-[10px] font-mono text-muted hover:text-accent hover:border-primary/40 transition-colors truncate min-w-0"
                   aria-label="Abrir repositorio crm-sanavit en GitHub (nueva pestaña)">
                  <span class="material-symbols-outlined text-[12px] shrink-0" aria-hidden="true">code</span>
                  <span class="truncate">github.com/Dfa2823/crm-sanavit</span>
                </a>
                <button type="button"
                        class="copy-repo shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-md bg-surface-1 border border-border text-muted hover:text-accent hover:border-primary/40 transition-colors"
                        data-copy="github.com/Dfa2823/crm-sanavit"
                        aria-label="Copiar URL del repositorio">
                  <span class="material-symbols-outlined text-[14px]" aria-hidden="true">content_copy</span>
                </button>
                <span class="copy-toast text-[10px] font-mono text-success opacity-0 transition-opacity shrink-0" role="status" aria-live="polite"></span>
              </div>
              <div class="flex gap-2">
                <span class="metric-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted"
                      data-spark="commits" data-spark-value="90">
                  <span class="spark inline-flex items-end gap-[2px] h-3" aria-hidden="true"></span>
                  90 commits
                </span>
                <span class="metric-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted"
                      data-spark="deploys" data-spark-value="85">
                  <span class="spark inline-flex items-end gap-[2px] h-3" aria-hidden="true"></span>
                  85 deploys
                </span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Card 3: DYV Command Center -->
      <article
        class="portfolio-card card-glow glass-panel rounded-xl p-6 flex flex-col group relative overflow-hidden lg:col-span-1 animate-fade-up delay-300"
        data-animate data-category="contabilidad" data-tilt
        data-project="DYV Command Center" data-project-en="DYV Command Center"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="rounded-lg overflow-hidden border border-border mb-5 relative h-48">
          <img
            src="/img/05_portfolio-2.png"
            loading="lazy" decoding="async"
            alt="Panel contable que muestra estado de sincronización de datos, indicadores de éxito en verde y registros de integración."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
          <div class="case-overlay">
            <a class="case-cta" href="#" data-wa-case rel="noopener" target="_blank">
              <span data-lang="es">Ver caso</span><span data-lang="en">See case</span>
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
        <div class="flex-grow flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Estética / Contabilidad</span>
                <span data-lang="en">Aesthetics / Accounting</span>
              </span>
            </div>
            <h3 class="font-display text-xl font-bold text-text mb-2">
              <span data-lang="es">DYV Command Center</span>
              <span data-lang="en">DYV Command Center</span>
            </h3>
            <p class="text-muted text-sm mb-4">
              <span data-lang="es">Carga automática a Odoo y conciliación bancaria centralizada.</span>
              <span data-lang="en">Automatic upload to Odoo and centralized bank reconciliation.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="inline-flex items-center gap-2 bg-success/10 px-3 py-1.5 rounded-md border border-success/20">
              <span class="material-symbols-outlined text-success text-sm" aria-hidden="true">timer</span>
              <span class="font-display font-bold text-success text-sm">
                <span data-lang="es">6h → 45min por cierre contable</span>
                <span data-lang="en">6h → 45min per accounting close</span>
              </span>
            </div>
          </div>
        </div>
      </article>

      <!-- Card 4: Automatizaciones N8N (ancha) -->
      <article
        class="portfolio-card card-glow glass-panel rounded-xl p-6 lg:col-span-2 group flex flex-col md:flex-row gap-6 relative overflow-hidden animate-fade-up delay-200"
        data-animate data-category="automatizacion" data-tilt
        data-project="Automatizaciones N8N" data-project-en="N8N Automations"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="md:w-1/2 flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Múltiples Sectores</span>
                <span data-lang="en">Multiple Sectors</span>
              </span>
            </div>
            <h3 class="font-display text-2xl font-bold text-text mb-2">
              <span data-lang="es">Automatizaciones N8N</span>
              <span data-lang="en">N8N Automations</span>
            </h3>
            <p class="text-muted text-sm mb-6">
              <span data-lang="es">Orquestación de flujos de trabajo complejos conectando APIs, bases de datos y herramientas de terceros sin fricción.</span>
              <span data-lang="en">Orchestration of complex workflows connecting APIs, databases, and third-party tools without friction.</span>
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <!-- Métricas (emerald reservado) -->
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">account_tree</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">+30 flujos activos</span>
                <span data-lang="en">30+ active flows</span>
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">delete_sweep</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">~500 h/mes eliminadas</span>
                <span data-lang="en">~500 h/month eliminated</span>
              </span>
            </div>
          </div>
        </div>
        <div class="md:w-1/2 rounded-lg overflow-hidden border border-border relative min-h-[14rem]">
          <img
            src="/img/05_portfolio-3.png"
            loading="lazy" decoding="async"
            alt="Representación visual de nodos de flujos N8N activos brillando sobre una cuadrícula oscura, conectando webhooks, bases de datos y funciones."
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-0/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="case-overlay">
            <a class="case-cta" href="#" data-wa-case rel="noopener" target="_blank">
              <span data-lang="es">Ver caso</span><span data-lang="en">See case</span>
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </article>

    </div>

    <!-- Sin resultados (filtro) -->
    <p id="portfolio-empty" class="hidden text-center text-muted text-sm mt-12" role="status" aria-live="polite">
      <span data-lang="es">No hay casos en este sector todavía. Pronto sumaremos más.</span>
      <span data-lang="en">No cases in this sector yet. We'll add more soon.</span>
    </p>

    <!-- Anuncio de resultados para lectores de pantalla -->
    <p id="portfolio-count" class="sr-only" role="status" aria-live="polite"></p>

    <!-- Trust Strip -->
    <div class="mt-20 py-8 border-y border-border/50 flex flex-wrap justify-center items-center gap-6 md:gap-12 text-center animate-fade-up" data-animate>
      <div class="trust-stat px-4 py-2 rounded-lg transition-colors">
        <span class="block font-display font-bold text-2xl md:text-3xl text-text mb-1">
          <span data-counter="15">0</span><span class="trust-suffix" data-suffix="+">+</span>
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">proyectos entregados</span>
          <span data-lang="en">projects delivered</span>
        </span>
      </div>
      <span class="trust-divider hidden md:block" aria-hidden="true"></span>
      <div class="trust-stat px-4 py-2 rounded-lg transition-colors">
        <!-- Métrica (emerald reservado) -->
        <span class="block font-display font-bold text-2xl md:text-3xl text-success mb-1">
          <span data-counter="10">0</span><span class="trust-suffix" data-suffix="k+">k+</span>
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">horas/mes automatizadas</span>
          <span data-lang="en">hours/month automated</span>
        </span>
      </div>
      <span class="trust-divider hidden md:block" aria-hidden="true"></span>
      <div class="trust-stat px-4 py-2 rounded-lg transition-colors">
        <span class="block font-display font-bold text-2xl md:text-3xl text-text mb-1">
          <span data-counter="4">0</span>
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">sectores</span>
          <span data-lang="en">sectors</span>
        </span>
      </div>
    </div>

    <!-- CTA inferior -->
    <div class="mt-24 text-center max-w-2xl mx-auto animate-fade-up" data-animate>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-text mb-6">
        <span data-lang="es">¿Tienes un proyecto en mente?</span>
        <span data-lang="en">Have a project in mind?</span>
      </h2>
      <a id="portfolio-cta" href={WA_PROYECTO} data-wa-base={WA_PROYECTO} target="_blank" rel="noopener"
         class="btn-primary px-8 py-4 text-lg inline-flex items-center gap-2 group">
        <span data-lang="es">Cuéntanos tu reto</span>
        <span data-lang="en">Tell us your challenge</span>
        <span class="material-symbols-outlined transition-transform group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
      </a>
      <p class="mt-4 text-xs text-muted flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[16px] text-success" aria-hidden="true">verified</span>
        <span data-lang="es">Diagnóstico gratis · Sin permanencia · Respuesta en &lt;24h</span>
        <span data-lang="en">Free diagnosis · No lock-in · Reply in &lt;24h</span>
      </p>
    </div>

  </div>

<style is:global>
  /* Chips de filtro del portafolio */
  #portfolio-filters .filter-chip.active {
    background-color: rgba(106,195,198, 0.15);
    color: #F4F6FF;
    border-color: rgba(106,195,198, 0.3);
  }
  #portfolio-filters .filter-chip:focus-visible {
    outline: 2px solid #6AC3C6;
    outline-offset: 2px;
  }

  /* Tarjetas: tilt 3D + transición al filtrar */
  .portfolio-card {
    transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .portfolio-card:hover { border-color: rgba(106,195,198, 0.35); }
  /* Animación de salida al filtrar (antes de display:none) */
  .portfolio-card.is-leaving { opacity: 0; transform: scale(0.96); pointer-events: none; }
  .portfolio-card.is-hidden { display: none; }
  /* Animación de entrada al filtrar */
  @keyframes portfolio-card-in {
    from { opacity: 0; transform: translateY(10px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }
  .portfolio-card.is-entering { animation: portfolio-card-in 0.35s ease-out both; }

  /* Overlay "Ver caso" sobre la imagen */
  .case-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 2;
  }
  .group:hover .case-overlay,
  .group:focus-within .case-overlay { opacity: 1; }
  .case-cta {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 0.6rem;
    background: #6AC3C6;
    color: #07101F;
    font-family: "Source Code Pro", ui-monospace, monospace;
    font-weight: 700;
    font-size: 0.8rem;
    transform: translateY(6px);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 8px 24px -8px rgba(106,195,198,0.6);
  }
  .group:hover .case-cta,
  .group:focus-within .case-cta { transform: translateY(0); }
  .case-cta:active { transform: scale(0.97); }

  /* Mini sparklines de commits/deploys */
  .metric-pill .spark { width: 28px; }
  .metric-pill .spark span {
    display: inline-block;
    width: 3px;
    background: #6AC3C6;
    border-radius: 1px;
    height: 0;
    transition: height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0.85;
  }

  /* Botón copiar repo */
  .copy-repo:active { transform: scale(0.92); }

  /* Trust strip: divisor + hover por métrica */
  .trust-divider {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(106,195,198,0.4), transparent);
  }
  .trust-stat:hover { background-color: rgba(106,195,198, 0.06); }
  .trust-suffix { opacity: 0; transition: opacity 0.3s ease; }
  .trust-suffix.is-revealed { opacity: 1; }

  /* Respeta prefers-reduced-motion para todo lo nuevo */
  @media (prefers-reduced-motion: reduce) {
    .portfolio-card { transition: opacity 0.2s ease; will-change: auto; }
    .portfolio-card.is-entering { animation: none; }
    .case-overlay, .case-cta { transition: opacity 0.2s ease; }
    .case-cta { transform: none; }
    .metric-pill .spark span { transition: none; }
    .trust-suffix { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById('portfolio-filters');
    if (!root) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isEN = () => document.documentElement.getAttribute('data-active-lang') === 'en';

    const chips = Array.from(root.querySelectorAll('.filter-chip'));
    const cards = Array.from(document.querySelectorAll('.portfolio-card'));
    const empty = document.getElementById('portfolio-empty');
    const countEl = document.getElementById('portfolio-count');
    const cta = document.getElementById('portfolio-cta');

    let activeKey = 'todos';

    // --- Etiquetas de sector para el deep-link contextual del CTA ---
    const filterLabel = {
      todos:          { es: '',                en: '' },
      salud:          { es: 'Salud & Estética', en: 'Health & Aesthetics' },
      contabilidad:   { es: 'Contabilidad',     en: 'Accounting' },
      manufactura:    { es: 'Manufactura',      en: 'Manufacturing' },
      automatizacion: { es: 'Automatización',   en: 'Automation' },
    };

    function updateCTA() {
      if (!cta) return;
      const base = cta.getAttribute('data-wa-base') || cta.href;
      const lbl = filterLabel[activeKey];
      let msg;
      if (!lbl || activeKey === 'todos') {
        msg = isEN() ? 'Hi, I want to talk about a project'
                     : 'Hola, quiero hablar sobre un proyecto';
      } else if (isEN()) {
        msg = 'Hi, I saw your ' + lbl.en + ' cases and I want something similar';
      } else {
        msg = 'Hola, vi sus casos de ' + lbl.es + ' y quiero algo similar';
      }
      cta.href = base.split('?')[0] + '?text=' + encodeURIComponent(msg);
    }

    // --- Conteo accesible + estado vacío ---
    function announce(visible) {
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      if (countEl) {
        countEl.textContent = isEN()
          ? visible + (visible === 1 ? ' case shown' : ' cases shown')
          : visible + (visible === 1 ? ' caso mostrado' : ' casos mostrados');
      }
    }

    // --- Filtrado con transición de salida/entrada ---
    function applyFilter(key) {
      activeKey = key;
      let visible = 0;
      cards.forEach(card => {
        const cats = (card.getAttribute('data-category') || '').split(/\s+/);
        const show = key === 'todos' || cats.indexOf(key) !== -1;
        const wasHidden = card.classList.contains('is-hidden');
        if (show) visible++;

        if (show) {
          if (wasHidden) {
            card.classList.remove('is-hidden', 'is-leaving');
            if (!reduceMotion) {
              card.classList.add('is-entering');
              card.addEventListener('animationend', () => card.classList.remove('is-entering'), { once: true });
            }
          }
        } else if (!wasHidden) {
          if (reduceMotion) {
            card.classList.add('is-hidden');
          } else {
            card.classList.add('is-leaving');
            const onEnd = () => { card.classList.add('is-hidden'); card.removeEventListener('transitionend', onEnd); };
            card.addEventListener('transitionend', onEnd);
            // Fallback si transitionend no dispara
            setTimeout(() => { if (card.classList.contains('is-leaving')) card.classList.add('is-hidden'); }, 360);
          }
        }
      });
      announce(visible);
      updateCTA();
    }

    function activate(chip) {
      chips.forEach(c => {
        const on = c === chip;
        c.classList.toggle('active', on);
        c.classList.toggle('text-text', on);
        c.classList.toggle('text-muted', !on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
        c.setAttribute('tabindex', on ? '0' : '-1'); // roving tabindex
      });
      applyFilter(chip.getAttribute('data-filter') || 'todos');
    }

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => activate(chip));
      chip.addEventListener('keydown', e => {
        // Roving tabindex: flechas SOLO mueven el foco; Enter/Space activan
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft' || e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          let idx;
          if (e.key === 'Home') idx = 0;
          else if (e.key === 'End') idx = chips.length - 1;
          else idx = (i + (e.key === 'ArrowRight' ? 1 : -1) + chips.length) % chips.length;
          chips.forEach(c => c.setAttribute('tabindex', '-1'));
          chips[idx].setAttribute('tabindex', '0');
          chips[idx].focus();
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate(chip);
        }
      });
    });

    // --- Overlay "Ver caso": WhatsApp prellenado por proyecto ---
    const WA = 'https://wa.me/573194436045';
    cards.forEach(card => {
      const link = card.querySelector('[data-wa-case]');
      if (!link) return;
      function setHref() {
        const name = (isEN() ? card.getAttribute('data-project-en') : card.getAttribute('data-project'))
                   || card.getAttribute('data-project') || '';
        const msg = isEN()
          ? 'Hi, I saw the "' + name + '" case and I want something similar'
          : 'Hola, vi el caso de "' + name + '" y quiero algo similar';
        link.href = WA + '?text=' + encodeURIComponent(msg);
      }
      setHref();
      link.addEventListener('mouseenter', setHref);
      link.addEventListener('focus', setHref);
      link.addEventListener('click', setHref);
    });

    // --- Copiar URL del repositorio con feedback ---
    document.querySelectorAll('.copy-repo').forEach(btn => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        const toast = btn.parentElement ? btn.parentElement.querySelector('.copy-toast') : null;
        let ok = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
            ok = true;
          }
        } catch (e) { ok = false; }
        if (!ok) {
          try {
            const ta = document.createElement('textarea');
            ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            ok = document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) { ok = false; }
        }
        const icon = btn.querySelector('.material-symbols-outlined');
        if (icon) icon.textContent = ok ? 'check' : 'error';
        if (toast) {
          toast.textContent = ok ? (isEN() ? 'Copied' : 'Copiado') : (isEN() ? 'Error' : 'Error');
          toast.style.opacity = '1';
        }
        setTimeout(() => {
          if (icon) icon.textContent = 'content_copy';
          if (toast) toast.style.opacity = '0';
        }, 1500);
      });
    });

    // --- Sparklines de commits/deploys (animadas al entrar en viewport) ---
    const sparks = Array.from(document.querySelectorAll('.metric-pill .spark'));
    function buildSpark(spark) {
      if (spark.dataset.built) return;
      spark.dataset.built = '1';
      // Patrón pseudoaleatorio determinista (sin libs) para 6 barras
      const seed = parseInt(spark.closest('.metric-pill')?.getAttribute('data-spark-value') || '8', 10);
      const heights = [0.45, 0.7, 0.35, 0.85, 0.6, 1].map((h, idx) => {
        const jitter = ((seed * (idx + 3)) % 5) / 20; // 0..0.2
        return Math.max(0.25, Math.min(1, h - jitter + 0.08));
      });
      heights.forEach(h => {
        const bar = document.createElement('span');
        bar.style.height = '0';
        bar.dataset.h = String(Math.round(h * 12)); // px sobre h-3 (12px)
        spark.appendChild(bar);
      });
    }
    if (sparks.length) {
      const sparkIO = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const spark = entry.target;
          buildSpark(spark);
          const bars = Array.from(spark.children);
          bars.forEach((bar, idx) => {
            const finalH = bar.dataset.h + 'px';
            if (reduceMotion) { bar.style.height = finalH; }
            else { setTimeout(() => { bar.style.height = finalH; }, idx * 70); }
          });
          sparkIO.unobserve(spark);
        });
      }, { threshold: 0.4 });
      sparks.forEach(s => sparkIO.observe(s));
    }

    // --- Tilt 3D sutil en las tarjetas (gateado por reduced-motion) ---
    if (!reduceMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll('.portfolio-card[data-tilt]').forEach(card => {
        const MAX = 5; // grados
        card.style.perspective = '900px';
        card.addEventListener('mousemove', e => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          card.style.transform = 'rotateY(' + (px * MAX) + 'deg) rotateX(' + (-py * MAX) + 'deg)';
        });
        card.addEventListener('mouseleave', () => { card.style.transform = ''; });
      });
    }

    // --- Revelar el sufijo del Trust Strip al terminar el count-up ---
    document.querySelectorAll('.trust-suffix').forEach(sfx => {
      const numSpan = sfx.parentElement ? sfx.parentElement.querySelector('[data-counter]') : null;
      if (!numSpan) { sfx.classList.add('is-revealed'); return; }
      const target = parseInt(numSpan.getAttribute('data-counter') || '0', 10);
      if (reduceMotion || target === 0) { sfx.classList.add('is-revealed'); return; }
      // Sondear hasta que el contador alcance su valor final
      const poll = setInterval(() => {
        if (parseInt(numSpan.textContent || '0', 10) >= target) {
          sfx.classList.add('is-revealed');
          clearInterval(poll);
        }
      }, 120);
      setTimeout(() => { sfx.classList.add('is-revealed'); clearInterval(poll); }, 3000);
    });

    // --- Mantener CTA y overlays sincronizados con el cambio de idioma ---
    document.querySelectorAll('[data-lang-btn], [data-lang-toggle], .lang-opt').forEach(btn => {
      btn.addEventListener('click', () => { setTimeout(updateCTA, 0); });
    });

    // Estado inicial
    updateCTA();
  })();
</script>
</section>
