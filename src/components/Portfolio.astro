---
// Portfolio — Casos de éxito reales (bento grid premium).
// ES copy proviene del diseño Stitch; EN del componente previo (traducido fiel donde no existía).
// Emerald (text-success) reservado estrictamente para métricas/ROI/prueba.
const WA_PROYECTO = 'https://wa.me/573194436045?text=Hola%2C%20quiero%20hablar%20sobre%20un%20proyecto';

const filters = [
  { key: 'todos',      es: 'Todos',            en: 'All' },
  { key: 'salud',      es: 'Salud & Estética', en: 'Health & Aesthetics' },
  { key: 'contabilidad', es: 'Contabilidad',   en: 'Accounting' },
  { key: 'manufactura',  es: 'Manufactura',    en: 'Manufacturing' },
  { key: 'automatizacion', es: 'Automatización', en: 'Automation' },
];
---
<section id="portafolio" class="relative overflow-hidden py-24 px-6 md:px-8">
  <!-- Aurora sutil de fondo (radial, sin canvas) -->
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true"
       style="background: radial-gradient(circle at 20% 30%, rgba(30,59,255,0.06) 0%, transparent 50%), radial-gradient(circle at 80% 70%, rgba(0,212,255,0.06) 0%, transparent 50%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto w-full">

    <!-- Encabezado -->
    <div class="text-center max-w-3xl mx-auto mb-16 animate-fade-up" data-animate>
      <span class="inline-block uppercase tracking-widest text-xs font-semibold bg-primary/10 text-accent border border-primary/20 px-3 py-1 rounded-full mb-6 font-display">
        <span data-lang="es">Portafolio</span>
        <span data-lang="en">Portfolio</span>
      </span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-text">
        <span data-lang="es">Casos de éxito <span class="gradient-text">reales.</span></span>
        <span data-lang="en">Real success <span class="gradient-text">stories.</span></span>
      </h2>
      <p class="text-lg text-muted leading-relaxed">
        <span data-lang="es">Estas empresas tenían el mismo problema que tú: procesos lentos, datos dispersos y equipos ahogados en tareas manuales.</span>
        <span data-lang="en">These companies had the same problem as you: slow processes, scattered data, and teams drowning in manual tasks.</span>
      </p>
    </div>

    <!-- Chips de filtro -->
    <div id="portfolio-filters" class="flex flex-wrap justify-center gap-3 mb-16 animate-fade-up delay-100" data-animate role="group" aria-label="Filtrar casos por sector">
      {filters.map((f, i) => (
        <button
          type="button"
          class={`filter-chip px-4 py-2 rounded-full border border-border bg-surface-1 text-sm font-medium transition-all ${i === 0 ? 'active text-text' : 'text-muted hover:text-text hover:border-border/80'}`}
          data-filter={f.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <span data-lang="es">{f.es}</span>
          <span data-lang="en">{f.en}</span>
        </button>
      ))}
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- Card flagship SOFY (ancha) -->
      <article
        class="portfolio-card glass-panel rounded-xl p-6 lg:col-span-2 group flex flex-col md:flex-row gap-6 relative overflow-hidden animate-fade-up delay-100"
        data-animate data-category="manufactura"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="md:w-1/2 flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Producción / Manufactura</span>
                <span data-lang="en">Production / Manufacturing</span>
              </span>
            </div>
            <h3 class="font-display text-2xl font-bold text-text mb-2">
              <span data-lang="es">SOFY — ERP Industrial a Medida</span>
              <span data-lang="en">SOFY — Custom Industrial ERP</span>
            </h3>
            <p class="text-muted text-sm mb-6">
              <span data-lang="es">Plataforma integral para gestión de planta, inventario en tiempo real y flujos de trabajo de manufactura.</span>
              <span data-lang="en">All-in-one platform for plant management, real-time inventory, and manufacturing workflows.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="flex items-center gap-2 mb-4">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">check_circle</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">Control total de producción</span>
                <span data-lang="en">Full production control</span>
              </span>
            </div>
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">
                <span class="material-symbols-outlined text-[14px] mr-1" aria-hidden="true">commit</span> 258 commits
              </span>
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">
                <span class="material-symbols-outlined text-[14px] mr-1" aria-hidden="true">rocket_launch</span> 264 deploys
              </span>
            </div>
          </div>
        </div>
        <div class="md:w-1/2 rounded-lg overflow-hidden border border-border relative min-h-[14rem]">
          <img
            src="/img/05_portfolio-0.png"
            loading="lazy" decoding="async"
            alt="Dashboard del ERP industrial SOFY: métricas de planta, gráficos y diagramas de flujo de manufactura en tema oscuro."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-0/80 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </article>

      <!-- Card 2: CRM Comercial -->
      <article
        class="portfolio-card glass-panel rounded-xl p-6 flex flex-col group relative overflow-hidden animate-fade-up delay-200"
        data-animate data-category="salud"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="rounded-lg overflow-hidden border border-border mb-5 relative h-48">
          <img
            src="/img/05_portfolio-1.png"
            loading="lazy" decoding="async"
            alt="Interfaz de CRM para salud y estética: agenda de citas, pipeline de pacientes y actividad reciente en UI oscura."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <div class="flex-grow flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Salud & Estética</span>
                <span data-lang="en">Health & Aesthetics</span>
              </span>
            </div>
            <h3 class="font-display text-xl font-bold text-text mb-2">
              <span data-lang="es">CRM Comercial Integral</span>
              <span data-lang="en">Full Commercial CRM</span>
            </h3>
            <p class="text-muted text-sm mb-4">
              <span data-lang="es">Pipeline 100% visible. Gestión de citas y seguimiento de leads automatizado.</span>
              <span data-lang="en">Pipeline 100% visible. Automated appointment management and lead tracking.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="inline-flex items-center gap-2 mb-4 bg-success/10 px-3 py-1.5 rounded-md border border-success/20">
              <span class="material-symbols-outlined text-success text-sm" aria-hidden="true">trending_down</span>
              <span class="font-display font-bold text-success text-sm">
                <span data-lang="es">~15 h/semana ahorradas</span>
                <span data-lang="en">~15 h/week saved</span>
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-[10px] font-mono text-muted truncate">
                github.com/Dfa2823/crm-sanavit
              </span>
              <div class="flex gap-2">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">90 commits</span>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-surface-1 border border-border text-xs font-mono text-muted">85 deploys</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Card 3: DYV Command Center -->
      <article
        class="portfolio-card glass-panel rounded-xl p-6 flex flex-col group relative overflow-hidden lg:col-span-1 animate-fade-up delay-300"
        data-animate data-category="contabilidad salud"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="rounded-lg overflow-hidden border border-border mb-5 relative h-48">
          <img
            src="/img/05_portfolio-2.png"
            loading="lazy" decoding="async"
            alt="Panel contable que muestra estado de sincronización de datos, indicadores de éxito en verde y registros de integración."
            class="w-full h-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
          />
        </div>
        <div class="flex-grow flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Estética / Contabilidad</span>
                <span data-lang="en">Aesthetics / Accounting</span>
              </span>
            </div>
            <h3 class="font-display text-xl font-bold text-text mb-2">
              <span data-lang="es">DYV Command Center</span>
              <span data-lang="en">DYV Command Center</span>
            </h3>
            <p class="text-muted text-sm mb-4">
              <span data-lang="es">Carga automática a Odoo y conciliación bancaria centralizada.</span>
              <span data-lang="en">Automatic upload to Odoo and centralized bank reconciliation.</span>
            </p>
          </div>
          <div>
            <!-- Métrica (emerald reservado) -->
            <div class="inline-flex items-center gap-2 bg-success/10 px-3 py-1.5 rounded-md border border-success/20">
              <span class="material-symbols-outlined text-success text-sm" aria-hidden="true">timer</span>
              <span class="font-display font-bold text-success text-sm">
                <span data-lang="es">6h → 45min por cierre contable</span>
                <span data-lang="en">6h → 45min per accounting close</span>
              </span>
            </div>
          </div>
        </div>
      </article>

      <!-- Card 4: Automatizaciones N8N (ancha) -->
      <article
        class="portfolio-card glass-panel rounded-xl p-6 lg:col-span-2 group flex flex-col md:flex-row gap-6 relative overflow-hidden animate-fade-up delay-200"
        data-animate data-category="automatizacion"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="md:w-1/2 flex flex-col justify-between relative z-10">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-mono text-muted uppercase tracking-wider">
                <span data-lang="es">Múltiples Sectores</span>
                <span data-lang="en">Multiple Sectors</span>
              </span>
            </div>
            <h3 class="font-display text-2xl font-bold text-text mb-2">
              <span data-lang="es">Automatizaciones N8N</span>
              <span data-lang="en">N8N Automations</span>
            </h3>
            <p class="text-muted text-sm mb-6">
              <span data-lang="es">Orquestación de flujos de trabajo complejos conectando APIs, bases de datos y herramientas de terceros sin fricción.</span>
              <span data-lang="en">Orchestration of complex workflows connecting APIs, databases, and third-party tools without friction.</span>
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <!-- Métricas (emerald reservado) -->
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">account_tree</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">+30 flujos activos</span>
                <span data-lang="en">30+ active flows</span>
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-success text-xl" aria-hidden="true">delete_sweep</span>
              <span class="font-display font-bold text-success text-lg">
                <span data-lang="es">~500 h/mes eliminadas</span>
                <span data-lang="en">~500 h/month eliminated</span>
              </span>
            </div>
          </div>
        </div>
        <div class="md:w-1/2 rounded-lg overflow-hidden border border-border relative min-h-[14rem]">
          <img
            src="/img/05_portfolio-3.png"
            loading="lazy" decoding="async"
            alt="Representación visual de nodos de flujos N8N activos brillando sobre una cuadrícula oscura, conectando webhooks, bases de datos y funciones."
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-surface-0/80 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </article>

    </div>

    <!-- Sin resultados (filtro) -->
    <p id="portfolio-empty" class="hidden text-center text-muted text-sm mt-12">
      <span data-lang="es">No hay casos en este sector todavía. Pronto sumaremos más.</span>
      <span data-lang="en">No cases in this sector yet. We'll add more soon.</span>
    </p>

    <!-- Trust Strip -->
    <div class="mt-20 py-8 border-y border-border/50 flex flex-wrap justify-center gap-8 md:gap-16 text-center animate-fade-up" data-animate>
      <div>
        <span class="block font-display font-bold text-2xl md:text-3xl text-text mb-1">
          <span data-counter="15">0</span>+
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">proyectos entregados</span>
          <span data-lang="en">projects delivered</span>
        </span>
      </div>
      <div>
        <!-- Métrica (emerald reservado) -->
        <span class="block font-display font-bold text-2xl md:text-3xl text-success mb-1">
          <span data-counter="10">0</span>k+
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">horas/mes automatizadas</span>
          <span data-lang="en">hours/month automated</span>
        </span>
      </div>
      <div>
        <span class="block font-display font-bold text-2xl md:text-3xl text-text mb-1">
          <span data-counter="4">0</span>
        </span>
        <span class="text-xs font-mono text-muted uppercase tracking-wider">
          <span data-lang="es">sectores</span>
          <span data-lang="en">sectors</span>
        </span>
      </div>
    </div>

    <!-- CTA inferior -->
    <div class="mt-24 text-center max-w-2xl mx-auto animate-fade-up" data-animate>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-text mb-6">
        <span data-lang="es">¿Tienes un proyecto en mente?</span>
        <span data-lang="en">Have a project in mind?</span>
      </h2>
      <a href={WA_PROYECTO} target="_blank" rel="noopener"
         class="btn-primary px-8 py-4 text-lg inline-flex items-center gap-2">
        <span data-lang="es">Cuéntanos tu reto</span>
        <span data-lang="en">Tell us your challenge</span>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      <p class="mt-4 text-xs text-muted flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-[16px] text-success" aria-hidden="true">verified</span>
        <span data-lang="es">Diagnóstico gratis · Sin permanencia · Respuesta en &lt;24h</span>
        <span data-lang="en">Free diagnosis · No lock-in · Reply in &lt;24h</span>
      </p>
    </div>

  </div>

<style is:global>
  /* Chips de filtro del portafolio */
  #portfolio-filters .filter-chip.active {
    background-color: rgba(30, 59, 255, 0.15);
    color: #F4F6FF;
    border-color: rgba(30, 59, 255, 0.3);
  }
  #portfolio-filters .filter-chip:focus-visible {
    outline: 2px solid #00D4FF;
    outline-offset: 2px;
  }
  /* Transición al filtrar las tarjetas */
  .portfolio-card { transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; }
  .portfolio-card.is-hidden { display: none; }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById('portfolio-filters');
    if (!root) return;
    const chips = Array.from(root.querySelectorAll('.filter-chip'));
    const cards = Array.from(document.querySelectorAll('.portfolio-card'));
    const empty = document.getElementById('portfolio-empty');

    function applyFilter(key) {
      let visible = 0;
      cards.forEach(card => {
        const cats = (card.getAttribute('data-category') || '').split(/\s+/);
        const show = key === 'todos' || cats.indexOf(key) !== -1;
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
    }

    function activate(chip) {
      chips.forEach(c => {
        const on = c === chip;
        c.classList.toggle('active', on);
        c.classList.toggle('text-text', on);
        c.classList.toggle('text-muted', !on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      applyFilter(chip.getAttribute('data-filter') || 'todos');
    }

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => activate(chip));
      // Navegación con flechas entre chips (accesibilidad)
      chip.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = chips[(i + dir + chips.length) % chips.length];
          next.focus();
          activate(next);
        }
      });
    });
  })();
</script>
</section>
