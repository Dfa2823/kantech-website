---
// Servicios — layout bento. "Agentes de IA" como card flagship (mockup de chat
// real), 3 cards de apoyo. CTA por card con WhatsApp prellenado. Toggle de
// tecnologías por card (accesible). EN tomado del componente actual; precios COP
// en ES, USD equivalente en EN.
import WhatsAppChatMockup from './WhatsAppChatMockup.astro';
const WA = 'https://wa.me/573194436045?text=';
const WA_NUMBER = '+57 319 443 6045';
const waAgent   = WA + encodeURIComponent('Hola KANTECH! Quiero un agente de IA que atienda a mis clientes 24/7.');
const waAuto    = WA + encodeURIComponent('Hola KANTECH! Quiero automatizar un proceso de mi empresa.');
const waProcess = WA + encodeURIComponent('Hola KANTECH! Quiero un diagnóstico gratuito de mis procesos.');
const waCustom  = WA + encodeURIComponent('Hola KANTECH! Quiero construir un sistema a medida (CRM/ERP/web).');
const waAdvice  = WA + encodeURIComponent('Hola, necesito ayuda para saber qué servicio me conviene');

// Tecnologías por servicio (tomadas del componente actual)
const techAgent   = ['LLM', 'Chatbots', 'WhatsApp', 'CRM Integration'];
const techAuto    = ['N8N', 'APIs', 'Webhooks', 'Odoo', 'Google Workspace'];
const techProcess = ['BPM', 'Diagnóstico', 'Consultoría', 'KPIs'];
const techCustom  = ['React', 'Node.js', 'PostgreSQL', 'Python', 'Google Apps Script'];

// Filtro "Por dónde empezar" — cada chip resalta el servicio recomendado.
// data-target = id de servicio (data-svc) que se resalta al activar el chip.
const startFilters = [
  { goal: 'clients', target: 'agent',   icon: 'support_agent',  es: 'Atender clientes', en: 'Serve clients' },
  { goal: 'hours',   target: 'auto',    icon: 'schedule',       es: 'Ahorrar horas',    en: 'Save hours' },
  { goal: 'costs',   target: 'process', icon: 'savings',        es: 'Reducir costos',   en: 'Cut costs' },
  { goal: 'build',   target: 'custom',  icon: 'code_blocks',    es: 'Construir sistema',en: 'Build system' },
];
---
<section id="servicios" class="relative py-24 px-6 overflow-hidden">
  <div class="relative z-10 max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-20 space-y-6 animate-fade-up" data-animate>
      <div class="section-label">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        <span data-lang="es">Servicios</span>
        <span data-lang="en">Services</span>
      </div>
      <h2 class="section-title text-4xl md:text-5xl lg:text-6xl">
        <span data-lang="es">Todo lo que tu empresa necesita, bajo un mismo <span class="gradient-text">techo.</span></span>
        <span data-lang="en">Everything your business needs, under one <span class="gradient-text">roof.</span></span>
      </h2>
      <p class="section-sub mx-auto">
        <span data-lang="es">No vendemos herramientas. Entregamos soluciones completas que generan resultados desde el primer mes.</span>
        <span data-lang="en">We don't sell tools. We deliver complete solutions that generate results from day one.</span>
      </p>
    </div>

    <!-- Filtro "Por dónde empezar" -->
    <div class="flex flex-col items-center mb-10 animate-fade-up delay-100" data-animate>
      <p class="text-xs font-headline tracking-widest text-muted uppercase mb-4">
        <span data-lang="es">¿Por dónde empezar?</span>
        <span data-lang="en">Where to start?</span>
      </p>
      <div id="svc-filter" class="flex flex-wrap justify-center gap-2.5" role="group" aria-label="Filtrar servicios por objetivo">
        {startFilters.map(f => (
          <button
            type="button"
            class="svc-filter-chip inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium bg-surface-1 border border-border text-muted hover:text-text hover:border-primary/50 transition-all duration-200 active:scale-[0.97]"
            data-goal={f.goal}
            data-target={f.target}
            aria-pressed="false"
          >
            <span class="material-symbols-outlined text-[18px]" aria-hidden="true">{f.icon}</span>
            <span data-lang="es">{f.es}</span><span data-lang="en">{f.en}</span>
          </button>
        ))}
        <button
          type="button"
          id="svc-filter-clear"
          class="svc-filter-clear hidden items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium text-muted hover:text-accent transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]" aria-hidden="true">restart_alt</span>
          <span data-lang="es">Ver todo</span><span data-lang="en">Show all</span>
        </button>
      </div>
      <p id="svc-filter-status" class="sr-only" role="status" aria-live="polite"></p>
    </div>

    <!-- Bento Grid -->
    <div id="svc-grid" class="grid grid-cols-1 md:grid-cols-12 gap-6">

      <!-- 1. Flagship: Agentes de IA (wide) -->
      <div data-svc="agent" data-goal="clients" class="svc-card card-glow col-span-1 md:col-span-12 lg:col-span-8 bg-surface-2 glass-panel rounded-xl border border-border p-8 lg:p-10 relative overflow-hidden group hover:-translate-y-1 hover:border-primary/40 transition-all duration-300 flex flex-col lg:flex-row gap-8 items-center animate-fade-up delay-100" data-animate>
        <!-- Glow on hover -->
        <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>

        <div class="flex-1 space-y-6 z-10">
          <div class="svc-reco-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/40 text-primary text-xs font-semibold">
            <span class="material-symbols-outlined text-[15px]" aria-hidden="true">recommend</span>
            <span data-lang="es">Recomendado para ti</span><span data-lang="en">Recommended for you</span>
          </div>
          <div class="w-12 h-12 rounded-lg bg-surface-1 border border-border flex items-center justify-center shadow-lg relative">
            <div class="absolute inset-0 bg-brand-gradient opacity-20 rounded-lg blur-md" aria-hidden="true"></div>
            <span class="material-symbols-outlined text-accent text-2xl relative z-10" aria-hidden="true">smart_toy</span>
          </div>
          <div>
            <h3 class="text-2xl font-headline font-bold text-white mb-3">
              <span data-lang="es">Agentes de IA</span>
              <span data-lang="en">AI Agents</span>
            </h3>
            <p class="text-muted leading-relaxed">
              <span data-lang="es">Un asistente que atiende a tus clientes 24/7, califica leads y agenda citas — sin contratar a nadie más. Nuestros clientes ahorran $3-5M COP/mes en personal solo con este servicio.</span>
              <span data-lang="en">An assistant that serves your clients 24/7, qualifies leads, and books appointments — without hiring anyone. Our clients save $700-1,200 USD/month in staffing with this service alone.</span>
            </p>
          </div>

          <!-- Proof badge (success reservado para métricas) -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-success/10 border border-success/20">
            <span class="material-symbols-outlined text-success text-[16px]" aria-hidden="true">trending_down</span>
            <span class="text-sm font-semibold text-success">
              <span data-lang="es">$3-5M COP/mes ahorrados</span>
              <span data-lang="en">$700-1,200 USD/mo saved</span>
            </span>
          </div>

          <!-- Toggle "Ver retorno" — mini-comparador ROI con cifras ya presentes -->
          <div>
            <button type="button" class="svc-roi-toggle inline-flex items-center gap-1.5 text-sm font-medium text-success/90 hover:text-success transition-colors" aria-expanded="false" aria-controls="svc-roi-agent">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">savings</span>
              <span data-lang="es">Ver retorno</span><span data-lang="en">See return</span>
              <span class="material-symbols-outlined text-[18px] svc-roi-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-roi-agent" class="mt-3 p-4 rounded-lg bg-surface-0 border border-border">
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-muted"><span data-lang="es">Atención 24/7 (sin contratar)</span><span data-lang="en">24/7 service (no hiring)</span></span>
                </div>
                <div class="flex items-baseline gap-2 mb-3">
                  <span class="font-headline font-bold text-2xl text-success"><span data-lang="es">$3-5M COP</span><span data-lang="en">$700-1,200 USD</span></span>
                  <span class="text-xs text-muted"><span data-lang="es">/mes ahorrados</span><span data-lang="en">/mo saved</span></span>
                </div>
                <div class="h-2 rounded-full bg-surface-2 overflow-hidden" aria-hidden="true">
                  <div class="svc-roi-bar h-full rounded-full bg-success/70"></div>
                </div>
                <p class="text-xs text-muted mt-2"><span data-lang="es">Equivale a un asesor de medio tiempo, trabajando todo el día.</span><span data-lang="en">Equivalent to a part-time rep, working all day long.</span></p>
              </div>
            </div></div>
          </div>

          <!-- Toggle tecnologías -->
          <div>
            <button type="button" class="svc-tech-toggle inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-accent transition-colors" aria-expanded="false" aria-controls="svc-tech-agent">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">memory</span>
              <span data-lang="es">Tecnologías</span><span data-lang="en">Technologies</span>
              <span class="material-symbols-outlined text-[18px] svc-tech-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-tech-agent" class="flex flex-wrap gap-2 mt-3">
                {techAgent.map(t => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-0 text-muted border border-border">{t}</span>
                ))}
              </div>
            </div></div>
          </div>

          <div class="pt-2 flex items-center gap-4 flex-wrap">
            <a href={waAgent} target="_blank" rel="noopener" class="svc-cta inline-flex items-center gap-2 px-3 py-2 -ml-3 rounded-lg text-primary hover:text-accent hover:bg-primary/10 font-semibold transition-all active:scale-[0.98] group/link">
              <span data-lang="es">Quiero un agente</span><span data-lang="en">I want an agent</span>
              <span class="material-symbols-outlined transform group-hover/link:translate-x-1 transition-transform" aria-hidden="true">arrow_right_alt</span>
            </a>
            <button type="button" class="svc-copy inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium text-muted hover:text-text hover:bg-surface-1 border border-border transition-all active:scale-[0.98]" data-copy={WA_NUMBER} aria-label="Copiar número de WhatsApp">
              <span class="material-symbols-outlined text-[18px] svc-copy-icon" aria-hidden="true">content_copy</span>
              <span class="svc-copy-label"><span data-lang="es">Copiar WhatsApp</span><span data-lang="en">Copy WhatsApp</span></span>
            </button>
          </div>
          <p class="svc-copy-toast sr-only" role="status" aria-live="polite"></p>
        </div>

        <!-- Visual: mockup de chat de WhatsApp (UI real, no imagen IA) -->
        <div class="w-full lg:w-[340px] h-[300px] relative rounded-lg border border-border overflow-hidden shadow-2xl z-10 flex-shrink-0">
          <WhatsAppChatMockup />
        </div>
      </div>

      <!-- 2. Automatizaciones -->
      <div data-svc="auto" data-goal="hours" class="svc-card card-glow col-span-1 md:col-span-6 lg:col-span-4 bg-surface-2 glass-panel rounded-xl border border-border p-8 relative overflow-hidden group hover:-translate-y-1 hover:border-primary/40 transition-all duration-300 flex flex-col animate-fade-up delay-200" data-animate>
        <div class="svc-reco-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/40 text-primary text-xs font-semibold mb-4 w-fit">
          <span class="material-symbols-outlined text-[15px]" aria-hidden="true">recommend</span>
          <span data-lang="es">Recomendado para ti</span><span data-lang="en">Recommended for you</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-surface-1 border border-border flex items-center justify-center mb-6 relative">
          <span class="material-symbols-outlined text-primary text-2xl z-10" aria-hidden="true">account_tree</span>
        </div>
        <h3 class="text-xl font-headline font-bold text-white mb-3">
          <span data-lang="es">Automatizaciones</span>
          <span data-lang="en">Automations</span>
        </h3>
        <p class="text-muted text-sm leading-relaxed flex-grow mb-6">
          <span data-lang="es">Eliminamos las tareas que tu equipo odia: copiar datos entre sistemas, enviar reportes, actualizar inventarios. Un flujo que ahorra 15 horas/semana cuesta desde $500.000 COP.</span>
          <span data-lang="en">We eliminate the tasks your team hates: copying data between systems, sending reports, updating inventory. A workflow that saves 15 hours/week starts at ~$120 USD.</span>
        </p>

        <div class="space-y-5 mt-auto">
          <!-- Métrica de ahorro (success reservado) -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-success/10 border border-success/20">
            <span class="material-symbols-outlined text-success text-[16px]" aria-hidden="true">schedule</span>
            <span class="text-xs font-semibold text-success">
              <span data-lang="es">15 h/semana ahorradas</span>
              <span data-lang="en">15 hrs/week saved</span>
            </span>
          </div>

          <!-- Toggle "Ver retorno" -->
          <div>
            <button type="button" class="svc-roi-toggle inline-flex items-center gap-1.5 text-sm font-medium text-success/90 hover:text-success transition-colors" aria-expanded="false" aria-controls="svc-roi-auto">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">savings</span>
              <span data-lang="es">Ver retorno</span><span data-lang="en">See return</span>
              <span class="material-symbols-outlined text-[18px] svc-roi-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-roi-auto" class="mt-3 p-4 rounded-lg bg-surface-0 border border-border">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm mb-3">
                  <span class="text-muted"><span data-lang="es">Inviertes desde</span><span data-lang="en">You invest from</span></span>
                  <span class="font-headline font-semibold text-text"><span data-lang="es">$500.000 COP</span><span data-lang="en">~$120 USD</span></span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm mb-3">
                  <span class="text-muted"><span data-lang="es">Recuperas</span><span data-lang="en">You recover</span></span>
                  <span class="font-headline font-bold text-success">15 h/<span data-lang="es">sem</span><span data-lang="en">wk</span></span>
                </div>
                <div class="h-2 rounded-full bg-surface-2 overflow-hidden" aria-hidden="true">
                  <div class="svc-roi-bar h-full rounded-full bg-success/70"></div>
                </div>
                <p class="text-xs text-success font-semibold mt-2"><span data-lang="es">Se paga solo en la 1ª semana.</span><span data-lang="en">Pays for itself in week 1.</span></p>
              </div>
            </div></div>
          </div>

          <!-- Toggle tecnologías -->
          <div>
            <button type="button" class="svc-tech-toggle inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-accent transition-colors" aria-expanded="false" aria-controls="svc-tech-auto">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">memory</span>
              <span data-lang="es">Tecnologías</span><span data-lang="en">Technologies</span>
              <span class="material-symbols-outlined text-[18px] svc-tech-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-tech-auto" class="flex flex-wrap gap-2 mt-3">
                {techAuto.map(t => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-0 text-muted border border-border">{t}</span>
                ))}
              </div>
            </div></div>
          </div>

          <div>
            <a href={waAuto} target="_blank" rel="noopener" class="svc-cta inline-flex items-center gap-2 px-3 py-2 -ml-3 rounded-lg text-white hover:text-accent hover:bg-primary/10 font-semibold transition-all text-sm active:scale-[0.98] group/link">
              <span data-lang="es">Automatizar mi proceso</span><span data-lang="en">Automate my process</span>
              <span class="material-symbols-outlined text-[18px] transform group-hover/link:translate-x-1 transition-transform" aria-hidden="true">arrow_right_alt</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 3. Mejoras de Proceso -->
      <div data-svc="process" data-goal="costs" class="svc-card card-glow col-span-1 md:col-span-6 lg:col-span-6 bg-surface-2 glass-panel rounded-xl border border-border p-8 relative overflow-hidden group hover:-translate-y-1 hover:border-primary/40 transition-all duration-300 flex flex-col animate-fade-up delay-300" data-animate>
        <div class="svc-reco-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/40 text-primary text-xs font-semibold mb-4 w-fit">
          <span class="material-symbols-outlined text-[15px]" aria-hidden="true">recommend</span>
          <span data-lang="es">Recomendado para ti</span><span data-lang="en">Recommended for you</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-surface-1 border border-border flex items-center justify-center mb-6 relative">
          <span class="material-symbols-outlined text-accent text-2xl z-10" aria-hidden="true">troubleshoot</span>
        </div>
        <h3 class="text-xl font-headline font-bold text-white mb-3">
          <span data-lang="es">Mejoras de Proceso</span>
          <span data-lang="en">Process Improvement</span>
        </h3>
        <p class="text-muted text-sm leading-relaxed flex-grow mb-6">
          <span data-lang="es">Encontramos dónde tu empresa pierde tiempo y dinero. Un diagnóstico de procesos puede revelar +$5M COP/mes en ineficiencias ocultas. El diagnóstico es gratis.</span>
          <span data-lang="en">We analyze and redesign your internal operations to eliminate bottlenecks, reduce costs, and free your team's time for what truly matters. The diagnosis is free.</span>
        </p>

        <div class="space-y-5 mt-auto">
          <!-- Diagnóstico gratis (success reservado: prueba/oferta) -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-success/10 border border-success/20">
            <span class="material-symbols-outlined text-success text-[16px]" aria-hidden="true">search_check</span>
            <span class="text-xs font-semibold text-success">
              <span data-lang="es">Diagnóstico gratis</span>
              <span data-lang="en">Free diagnosis</span>
            </span>
          </div>

          <!-- Toggle "Ver retorno" -->
          <div>
            <button type="button" class="svc-roi-toggle inline-flex items-center gap-1.5 text-sm font-medium text-success/90 hover:text-success transition-colors" aria-expanded="false" aria-controls="svc-roi-process">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">savings</span>
              <span data-lang="es">Ver retorno</span><span data-lang="en">See return</span>
              <span class="material-symbols-outlined text-[18px] svc-roi-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-roi-process" class="mt-3 p-4 rounded-lg bg-surface-0 border border-border">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm mb-3">
                  <span class="text-muted"><span data-lang="es">El diagnóstico cuesta</span><span data-lang="en">The diagnosis costs</span></span>
                  <span class="font-headline font-bold text-success"><span data-lang="es">$0</span><span data-lang="en">$0</span></span>
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm mb-3">
                  <span class="text-muted"><span data-lang="es">Ineficiencias que revela</span><span data-lang="en">Inefficiencies it reveals</span></span>
                  <span class="font-headline font-bold text-success"><span data-lang="es">+$5M COP/mes</span><span data-lang="en">+$1,200 USD/mo</span></span>
                </div>
                <div class="h-2 rounded-full bg-surface-2 overflow-hidden" aria-hidden="true">
                  <div class="svc-roi-bar h-full rounded-full bg-success/70"></div>
                </div>
                <p class="text-xs text-muted mt-2"><span data-lang="es">Cero riesgo: solo ganas claridad sobre dónde fugas dinero.</span><span data-lang="en">Zero risk: you only gain clarity on where money leaks.</span></p>
              </div>
            </div></div>
          </div>

          <!-- Toggle tecnologías -->
          <div>
            <button type="button" class="svc-tech-toggle inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-accent transition-colors" aria-expanded="false" aria-controls="svc-tech-process">
              <span class="material-symbols-outlined text-[18px]" aria-hidden="true">memory</span>
              <span data-lang="es">Tecnologías</span><span data-lang="en">Technologies</span>
              <span class="material-symbols-outlined text-[18px] svc-tech-chevron transition-transform" aria-hidden="true">expand_more</span>
            </button>
            <div class="svc-collapse"><div class="svc-collapse-inner">
              <div id="svc-tech-process" class="flex flex-wrap gap-2 mt-3">
                {techProcess.map(t => (
                  <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-surface-0 text-muted border border-border">{t}</span>
                ))}
              </div>
            </div></div>
          </div>

          <div>
            <a href={waProcess} target="_blank" rel="noopener" class="svc-cta inline-flex items-center gap-2 px-3 py-2 -ml-3 rounded-lg text-white hover:text-accent hover:bg-primary/10 font-semibold transition-all text-sm active:scale-[0.98] group/link">
              <span data-lang="es">Pedir diagnóstico</span><span data-lang="en">Request diagnosis</span>
              <span class="material-symbols-outlined text-[18px] transform group-hover/link:translate-x-1 transition-transform" aria-hidden="true">arrow_right_alt</span>
            </a>
          </div>
        </div>
      </div>

      <!-- 4. Desarrollo a Medida -->
      <div data-svc="custom" data-goal="build" class="svc-card card-glow col-span-1 md:col-span-12 lg:col-span-6 bg-surface-2 glass-panel rounded-xl border border-border p-8 relative overflow-hidden group hover:-translate-y-1 hover:border-primary/40 transition-all duration-300 flex flex-col animate-fade-up delay-400" data-animate>
        <div class="svc-reco-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/40 text-primary text-xs font-semibold mb-4 w-fit">
          <span class="material-symbols-outlined text-[15px]" aria-hidden="true">recommend</span>
          <span data-lang="es">Recomendado para ti</span><span data-lang="en">Recommended for you</span>
        </div>
        <div class="w-12 h-12 rounded-lg bg-surface-1 border border-border flex items-center justify-center mb-6 relative">
          <span class="material-symbols-outlined text-2xl z-10" style="color:#2E7E9E;" aria-hidden="true">code_blocks</span>
        </div>
        <h3 class="text-xl font-headline font-bold text-white mb-3">
