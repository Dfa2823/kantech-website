<style>
  /* Acordeón animado por altura (grid 0fr -> 1fr): sin saltos de layout */
  .svc-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .svc-collapse.is-open { grid-template-rows: 1fr; }
  .svc-collapse-inner {
    overflow: hidden;
    min-height: 0;
  }
  /* Barra de retorno: se "rellena" al abrir */
  .svc-roi-bar {
    width: 0;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
  }
  .svc-collapse.is-open .svc-roi-bar { width: 100%; }
  /* Chevrons giran vía clase (estado sincronizado con aria-expanded) */
  .svc-tech-toggle[aria-expanded="true"] .svc-tech-chevron,
  .svc-roi-toggle[aria-expanded="true"] .svc-roi-chevron { transform: rotate(180deg); }
  /* Filtro: atenuar cards no relevantes, resaltar la recomendada */
  .svc-card { transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease; }
  #svc-grid.is-filtering .svc-card:not(.svc-dimmed) {
    box-shadow: 0 0 0 1px rgba(106,195,198,0.5), 0 0 32px -8px rgba(106,195,198,0.4);
  }
  .svc-card.svc-dimmed { opacity: 0.4; }
  /* El badge no ocupa espacio hasta que la card es recomendada */
  .svc-card .svc-reco-badge { display: none; }
  .svc-card.svc-recommended .svc-reco-badge {
    display: inline-flex;
    animation: svc-badge-in 0.35s ease both;
  }
  @keyframes svc-badge-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .svc-filter-chip[aria-pressed="true"] {
    background-color: #6AC3C6;
    color: #07101F;
    border-color: #6AC3C6;
  }
  .svc-copy.is-copied { color: #2FD79F; border-color: rgba(47,215,159,0.4); }

  @media (prefers-reduced-motion: reduce) {
    .svc-collapse,
    .svc-roi-bar,
    .svc-card { transition: none !important; }
    .svc-card.svc-recommended .svc-reco-badge { animation: none !important; }
  }
</style>

<script is:inline>
  (function () {
    const root = document.getElementById('servicios');
    if (!root) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Acordeones animados (tecnologías + retorno), uno abierto por card ---- */
    const toggles = root.querySelectorAll('.svc-tech-toggle, .svc-roi-toggle');

    function getCollapse(btn) {
      // El wrapper .svc-collapse es el primer hermano tras el botón
      const next = btn.nextElementSibling;
      return next && next.classList.contains('svc-collapse') ? next : null;
    }
    function closeToggle(btn) {
      const c = getCollapse(btn);
      if (c) c.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    }
    function openToggle(btn) {
      const card = btn.closest('.svc-card');
      // Cierra cualquier otro acordeón abierto dentro de la misma card
      if (card) {
        card.querySelectorAll('.svc-tech-toggle, .svc-roi-toggle').forEach(other => {
          if (other !== btn && other.getAttribute('aria-expanded') === 'true') closeToggle(other);
        });
      }
      const c = getCollapse(btn);
      if (c) c.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
    }

    toggles.forEach(btn => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        if (expanded) closeToggle(btn); else openToggle(btn);
      });
      btn.addEventListener('keydown', e => {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          closeToggle(btn);
          btn.focus();
        }
      });
    });

    /* ---- Filtro "Por dónde empezar" ---- */
    const grid = document.getElementById('svc-grid');
    const cards = root.querySelectorAll('.svc-card');
    const chips = root.querySelectorAll('.svc-filter-chip');
    const clearBtn = document.getElementById('svc-filter-clear');
    const status = document.getElementById('svc-filter-status');
    let activeGoal = null;

    function clearFilter() {
      activeGoal = null;
      chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
      cards.forEach(card => card.classList.remove('svc-dimmed', 'svc-recommended'));
      if (grid) grid.classList.remove('is-filtering');
      if (clearBtn) { clearBtn.classList.add('hidden'); clearBtn.classList.remove('inline-flex'); }
      if (status) status.textContent = '';
    }

    function applyFilter(goal, targetSvc, chip) {
      activeGoal = goal;
      chips.forEach(c => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach(card => {
        const match = card.dataset.goal === goal;
        card.classList.toggle('svc-dimmed', !match);
        card.classList.toggle('svc-recommended', match);
      });
      if (grid) grid.classList.add('is-filtering');
      if (clearBtn) { clearBtn.classList.remove('hidden'); clearBtn.classList.add('inline-flex'); }
      const recommended = root.querySelector('.svc-card[data-svc="' + targetSvc + '"]');
      if (status) {
        const h3 = recommended && recommended.querySelector('h3 [data-lang="es"]');
        status.textContent = 'Servicio recomendado: ' + (h3 ? h3.textContent : targetSvc);
      }
      // Llevar la card recomendada a la vista en pantallas pequeñas
      if (recommended && window.innerWidth < 768) {
        recommended.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const goal = chip.dataset.goal;
        if (activeGoal === goal) { clearFilter(); return; } // toggle off
        applyFilter(goal, chip.dataset.target, chip);
      });
    });
    if (clearBtn) clearBtn.addEventListener('click', clearFilter);

    /* ---- Copiar número de WhatsApp al portapapeles (lead que no hace clic) ---- */
    root.querySelectorAll('.svc-copy').forEach(btn => {
      const card = btn.closest('.svc-card') || root;
      const toast = card.querySelector('.svc-copy-toast');
      const labelWrap = btn.querySelector('.svc-copy-label');
      const icon = btn.querySelector('.svc-copy-icon');
      const number = btn.getAttribute('data-copy') || '';
      let resetId = null;

      async function copyNumber() {
        let ok = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(number);
            ok = true;
          }
        } catch (e) { ok = false; }
        if (!ok) {
          // Fallback para contextos sin Clipboard API
          try {
            const ta = document.createElement('textarea');
            ta.value = number;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            ok = document.execCommand('copy');
            document.body.removeChild(ta);
          } catch (e) { ok = false; }
        }
        const lang = document.documentElement.getAttribute('data-active-lang') === 'en' ? 'en' : 'es';
        if (toast) {
          toast.textContent = ok
            ? (lang === 'en' ? 'WhatsApp number copied' : 'Número de WhatsApp copiado')
            : (lang === 'en' ? 'Could not copy. Number: ' + number : 'No se pudo copiar. Número: ' + number);
        }
        if (ok) {
          btn.classList.add('is-copied');
          if (icon) icon.textContent = 'check';
          if (labelWrap) {
            labelWrap.innerHTML = '<span data-lang="es">¡Copiado!</span><span data-lang="en">Copied!</span>';
          }
          clearTimeout(resetId);
          resetId = setTimeout(() => {
            btn.classList.remove('is-copied');
            if (icon) icon.textContent = 'content_copy';
            if (labelWrap) {
              labelWrap.innerHTML = '<span data-lang="es">Copiar WhatsApp</span><span data-lang="en">Copy WhatsApp</span>';
            }
          }, 2000);
        }
      }
      btn.addEventListener('click', copyNumber);
    });
  })();
</script>
