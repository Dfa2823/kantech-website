---
import SiteC from '../../layouts/SiteC.astro';
import Nav from '../../components/c/Nav.astro';
import Footer from '../../components/c/Footer.astro';
import TechMarquee from '../../components/c/TechMarquee.astro';
const WA = 'https://wa.me/573239250931?text=Hola%20KANTECH!%20Quiero%20un%20diagn%C3%B3stico%20gratuito%20de%20mis%20procesos.';
---
<SiteC
  title="Mejora y Optimización de Procesos — Diagnóstico Gratis | KANTECH"
  description="Encontramos dónde tu empresa pierde tiempo y dinero y rediseñamos tu operación para eliminar cuellos de botella y reducir costos. Diagnóstico de procesos gratis — KANTECH, Cali, Colombia."
  keywords="mejora de procesos, optimización de procesos, diagnóstico de procesos, reducir costos operativos, eficiencia operativa, consultoría de procesos, BPM, Colombia"
  path="/servicios/mejoras-de-proceso"
>
  <Nav home={false} />

  <!-- HERO -->
  <div style="position:relative;overflow:hidden;border-bottom:1px solid #16273f;">
    <div style="position:absolute;inset:0;background-image:linear-gradient(#15263f 1px,transparent 1px),linear-gradient(90deg,#15263f 1px,transparent 1px);background-size:48px 48px;opacity:.5;"></div>
    <div style="position:absolute;top:-140px;right:-60px;width:440px;height:440px;background:radial-gradient(circle,rgba(106,195,198,.18),transparent 70%);"></div>
    <div style="position:relative;max-width:1080px;margin:0 auto;padding:34px 32px 0;">
      <div style="font-size:12.5px;color:#5f76a0;">/ <a href="/" style="color:#6f84a8;">inicio</a> / <a href="/#servicios" style="color:#6f84a8;">servicios</a> / <span style="color:#6AC3C6;">mejoras_de_proceso</span></div>
    </div>
    <div style="position:relative;max-width:1080px;margin:0 auto;display:grid;grid-template-columns:1.05fr .95fr;gap:50px;padding:40px 32px 72px;align-items:center;">
      <div>
        <div style="display:inline-flex;align-items:center;gap:10px;color:#6AC3C6;font-size:13px;font-weight:600;border:1px solid #2c466f;border-radius:8px;padding:7px 13px;margin-bottom:26px;">servicio_03 · Process Improvement</div>
        <h1 style="font-size:46px;line-height:1.1;font-weight:700;color:#fff;margin:0 0 14px;letter-spacing:-.02em;">Encuentra dónde<br/><span style="color:#6AC3C6;">se_fuga_el_dinero.</span></h1>
        <p style="font-size:16.5px;line-height:1.7;color:#9fb2d4;margin:0 0 30px;max-width:480px;">Analizamos y rediseñamos tu operación para eliminar cuellos de botella, reducir costos y liberar el tiempo de tu equipo. El diagnóstico es gratis.</p>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:22px;">
          <a href={WA} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:10px;background:#6AC3C6;color:#0d1828;padding:15px 26px;border-radius:10px;font-size:15px;font-weight:700;">pedir_diagnóstico <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div style="display:flex;align-items:center;gap:20px;font-size:13px;color:#6f84a8;">
          <span style="display:flex;align-items:center;gap:7px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#6AC3C6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><circle cx="12" cy="12" r="9"/><polyline points="8.3 12.2 11 14.8 15.7 9.3"/></svg> el diagnóstico cuesta $0</span>
          <span style="display:flex;align-items:center;gap:7px;"><svg width="15" height="15" viewBox="0 0 24 24" fill="#6AC3C6" stroke="#6AC3C6" stroke-width="1.5" stroke-linejoin="round" style="flex:none;"><polygon points="13 2 5 13 11 13 10 22 19 10 13 10"/></svg> cero riesgo</span>
        </div>
      </div>
      <div style="background:#0a1322;border:1px solid #243a5e;border-radius:14px;overflow:hidden;box-shadow:0 30px 70px -30px rgba(0,0,0,.8);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 16px;background:#13233d;border-bottom:1px solid #243a5e;">
          <span style="color:#6f84a8;font-size:12px;">diagnóstico · mapa_de_fugas</span>
          <span style="font-size:11px;color:#8fdadc;">resumen</span>
        </div>
        <div style="padding:20px;display:flex;flex-direction:column;gap:14px;">
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;color:#9fb2d4;margin-bottom:6px;"><span>Doble digitación</span><span style="color:#ff8f6b;">alta fuga</span></div>
            <div style="height:7px;border-radius:999px;background:#13233d;overflow:hidden;"><div style="width:82%;height:100%;background:linear-gradient(90deg,#6AC3C6,#ff8f6b);"></div></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;color:#9fb2d4;margin-bottom:6px;"><span>Reportes manuales</span><span style="color:#febc2e;">media</span></div>
            <div style="height:7px;border-radius:999px;background:#13233d;overflow:hidden;"><div style="width:58%;height:100%;background:linear-gradient(90deg,#6AC3C6,#febc2e);"></div></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;font-size:12.5px;color:#9fb2d4;margin-bottom:6px;"><span>Seguimiento de leads</span><span style="color:#febc2e;">media</span></div>
            <div style="height:7px;border-radius:999px;background:#13233d;overflow:hidden;"><div style="width:64%;height:100%;background:linear-gradient(90deg,#6AC3C6,#febc2e);"></div></div>
          </div>
          <div style="border-top:1px dashed #243a5e;padding-top:14px;display:flex;align-items:baseline;justify-content:space-between;">
            <span style="font-size:12.5px;color:#6f84a8;">Ahorro potencial estimado</span>
            <span style="font-family:'Manrope',sans-serif;font-size:22px;font-weight:800;color:#6AC3C6;">+18 h/sem</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROBLEMA -->
  <div style="max-width:1080px;margin:0 auto;padding:80px 32px 10px;">
    <div style="color:#6AC3C6;font-size:13px;font-weight:600;margin-bottom:18px;">// el_problema</div>
    <p style="font-family:'Manrope',sans-serif;font-size:30px;font-weight:600;line-height:1.45;color:#e7eefb;margin:0;max-width:880px;letter-spacing:-.01em;">La mayoría de las empresas no pierde dinero en lo grande, sino en mil tareas pequeñas que nadie mide. <span style="color:#6AC3C6;">Primero hay que verlas.</span></p>
  </div>

  <!-- QUÉ INCLUYE -->
  <div style="max-width:1080px;margin:0 auto;padding:70px 32px 10px;">
    <div style="color:#6AC3C6;font-size:13px;font-weight:600;margin-bottom:30px;">// qué_incluye · what_you_get</div>
    <div style="border-top:1px solid #1d3052;">
      <div class="ix" style="display:grid;grid-template-columns:64px 1fr 1.2fr;gap:24px;align-items:center;padding:24px 14px;border-bottom:1px solid #1d3052;transition:.15s;"><span class="ixn" style="font-size:13px;color:#43618f;">01</span><div style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#fff;">Diagnóstico de procesos</div><p style="font-size:14px;color:#9fb2d4;margin:0;line-height:1.55;">Entrevistas y observación para entender cómo trabaja tu equipo hoy.</p></div>
      <div class="ix" style="display:grid;grid-template-columns:64px 1fr 1.2fr;gap:24px;align-items:center;padding:24px 14px;border-bottom:1px solid #1d3052;transition:.15s;"><span class="ixn" style="font-size:13px;color:#43618f;">02</span><div style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#fff;">Mapa de fugas</div><p style="font-size:14px;color:#9fb2d4;margin:0;line-height:1.55;">Dónde se pierde tiempo y dinero, cuantificado y priorizado.</p></div>
      <div class="ix" style="display:grid;grid-template-columns:64px 1fr 1.2fr;gap:24px;align-items:center;padding:24px 14px;border-bottom:1px solid #1d3052;transition:.15s;"><span class="ixn" style="font-size:13px;color:#43618f;">03</span><div style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#fff;">Rediseño de la operación</div><p style="font-size:14px;color:#9fb2d4;margin:0;line-height:1.55;">Un flujo más simple, con menos pasos manuales y menos errores.</p></div>
      <div class="ix" style="display:grid;grid-template-columns:64px 1fr 1.2fr;gap:24px;align-items:center;padding:24px 14px;border-bottom:1px solid #1d3052;transition:.15s;"><span class="ixn" style="font-size:13px;color:#43618f;">04</span><div style="font-family:'Manrope',sans-serif;font-size:18px;font-weight:700;color:#fff;">KPIs &amp; plan de implementación</div><p style="font-size:14px;color:#9fb2d4;margin:0;line-height:1.55;">Qué medir y en qué orden ejecutar para ver resultados pronto.</p></div>
    </div>
  </div>

  <!-- VALUE -->
  <div style="max-width:1080px;margin:0 auto;padding:70px 32px 10px;">
    <div style="border-top:1px solid #1d3052;border-bottom:1px solid #1d3052;padding:54px 0;text-align:center;">
      <p style="font-family:'Manrope',sans-serif;font-size:32px;font-weight:700;line-height:1.35;color:#fff;margin:0 auto;max-width:780px;letter-spacing:-.015em;">El diagnóstico es gratis.<br/><span style="color:#6AC3C6;">Solo ganas claridad sobre dónde se fuga el dinero.</span></p>
      <p style="font-size:14px;color:#5f76a0;margin:18px 0 0;">Cero riesgo. Decides tú si avanzamos o no.</p>
    </div>
  </div>

  <!-- TECH -->
  <div style="max-width:1080px;margin:0 auto;padding:46px 32px 10px;">
    <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:13px;color:#6f84a8;">
      <span style="color:#6AC3C6;">enfoque ▸</span>
      <span style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:600;color:#cdd9ec;">BPM</span><span style="color:#2c466f;">·</span>
      <span style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:600;color:#cdd9ec;">Diagnóstico</span><span style="color:#2c466f;">·</span>
      <span style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:600;color:#cdd9ec;">Consultoría</span><span style="color:#2c466f;">·</span>
      <span style="font-family:'Manrope',sans-serif;font-size:16px;font-weight:600;color:#cdd9ec;">KPIs</span>
    </div>
  </div>

  <!-- TECH MARQUEE -->
  <div style="max-width:1080px;margin:0 auto;padding:30px 32px 10px;">
    <div style="color:#6AC3C6;font-size:13px;font-weight:600;margin-bottom:24px;">// tecnologías · stack</div>
    <TechMarquee />
  </div>

  <!-- CTA BAND -->
  <div style="border-top:1px solid #1d3052;background:#0b1422;margin-top:70px;">
    <div style="max-width:1080px;margin:0 auto;padding:64px 32px;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;">
      <div>
        <h2 style="font-family:'Manrope',sans-serif;font-size:30px;font-weight:800;color:#fff;margin:0 0 8px;letter-spacing:-.02em;">Descubre tu ahorro potencial — gratis.</h2>
        <p style="font-size:14.5px;color:#9fb2d4;margin:0;">30 minutos por videollamada. Sin compromiso.</p>
      </div>
      <a href={WA} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:10px;background:#6AC3C6;color:#0d1828;padding:16px 28px;border-radius:10px;font-size:15px;font-weight:700;">Pedir diagnóstico <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;"><line x1="4" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
  </div>

  <Footer home={false} />
</SiteC>

<style>
  /* CSS específico de esta página (no existe en SiteC): el hover del índice
     cambia el color del número .ixn, en vez de la flecha .ixarrow del home. */
  .ix:hover .ixn { color: #6AC3C6; }
</style>
